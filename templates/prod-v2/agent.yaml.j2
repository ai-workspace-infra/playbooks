mode: agent
log:
  level: info
agent:
  id: {{ (prod_v2_node_id | default(edge.id)) | to_json }}
  role: agent-proxy
  region: {{ (prod_v2_region | default(edge.region | default('jp'))) | to_json }}
  pool: {{ (prod_v2_pool | default((prod_v2_region | default(edge.region | default('jp'))) ~ '-' ~ resource_class)) | to_json }}
  entryPoint: {{ (prod_v2_node_domain | default(edge.domain)) | to_json }}
  domain: {{ (prod_v2_node_domain | default(edge.domain)) | to_json }}
  openToUsers: true
  controllerUrl: {{ (prod_v2_accounts_url | default('https://' ~ (prod_v2_accounts_domain | default('accounts-selfhost-prod-v2.svc.plus')))) | to_json }}
  apiToken: {{ edge.token | to_json }}
  httpTimeout: 15s
  statusInterval: 30s
  syncInterval: 1m
  tls:
    insecureSkipVerify: false
billing:
  enabled: false
xray:
  sync:
    enabled: true
    interval: 1m
    targets:
{% for target in [{'name':'xhttp','config':'config.json','service':'xray'}, {'name':'tcp','config':'tcp-config.json','service':'xray-tcp'}] %}
      - name: {{ target.name }}
        outputPath: /usr/local/etc/xray/{{ target.config }}
        templatePath: /usr/local/etc/xray/templates/xray.{{ target.name }}.template.json
        validateCommand: [/usr/local/bin/xray, run, -test, -config, /usr/local/etc/xray/{{ target.config }}]
        restartCommand: [systemctl, restart, {{ target.service }}.service]
        dynamicUsers:
          enabled: true
          executable: /usr/local/bin/xray
          server: 127.0.0.1:{{ '10086' if target.name == 'xhttp' else '10087' }}
{% endfor %}
