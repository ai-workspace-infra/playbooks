# Managed by the release-owned SMTP profile. Accounts only; never shared with DB.
{% for key, value in prod_services_smtp_env | dictsort %}
{{ key }}='{{ value }}'
{% endfor %}
{# This existing Accounts-only env file also carries its scoped resolver token.
   Preserve that independently managed field when rotating SMTP credentials. #}
{{ (((accounts_scoped_runtime_existing | default({})).content | default('') | b64decode) | regex_search('(?m)^XCONNECT_OBSERVABILITY_SEARCH_TOKEN=[A-Za-z0-9_-]{32,}$')) | default('', true) }}
