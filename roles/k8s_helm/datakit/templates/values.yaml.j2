workload:
  kind: DaemonSet

datakit:
  dataway_secret_enabled: true
  dataway_secret_create: false
  dataway_secret_name: "{{ datakit_dataway_secret_name }}"
  dataway_secret_key: "ENV_DATAWAY"
  global_tags: "{{ datakit_global_tags }}"
  default_enabled_inputs: "{{ datakit_default_inputs }}"
  log: "{{ datakit_log_level }}"

extraEnvs:
{% if datakit_enable_opentelemetry %}
  - name: "ENV_INPUT_OTEL_GRPC"
    value: '{"addr": "{{ datakit_otel_grpc_addr }}", "max_payload": 16777216}'
  - name: "ENV_INPUT_OTEL_HTTP"
    value: '{"enable": true, "http_status_ok": 200, "trace_api": "/otel/v1/traces", "metric_api": "/otel/v1/metrics", "logs_api": "/otel/v1/logs"}'
  - name: "ENV_INPUT_OTEL_CUSTOMER_TAGS_ALL"
    value: "true"
  - name: "ENV_INPUT_OTEL_METRIC_ENABLE_AGGREGATE"
    value: "true"
{% endif %}
  - name: "ENV_INPUT_CONTAINER_CONTAINER_INCLUDE_LOG"
    value: "{{ datakit_business_log_namespace_selector }}"

dkconfig:
  - name: "caddy-metrics.conf"
    path: "/usr/local/datakit/conf.d/prom/caddy-metrics.conf"
    value: |
      [[inputs.prom]]
        urls = ["{{ datakit_caddy_metrics_url }}"]
        source = "caddy"
        interval = "15s"
        measurement_name = "caddy"
        keep_exist_metric_name = true
        election = false
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "caddy-ingress"
          instance = "caddy-ingress-caddy"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"
  - name: "postgresql-exporter.conf"
    path: "/usr/local/datakit/conf.d/prom/postgresql-exporter.conf"
    value: |
      [[inputs.prom]]
        urls = ["{{ datakit_postgresql_metrics_url }}"]
        source = "postgresql"
        interval = "15s"
        measurement_name = "postgresql"
        keep_exist_metric_name = true
        election = false
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "postgresql"
          instance = "prod-postgresql-0"
          db_instance = "postgresql"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"
  - name: "kube-state-metrics.conf"
    path: "/usr/local/datakit/conf.d/prom/kube-state-metrics.conf"
    value: |
      [[inputs.prom]]
        urls = ["{{ datakit_kube_state_metrics_url }}"]
        source = "kube-state-metrics"
        interval = "15s"
        measurement_name = "kube-state-metrics"
        keep_exist_metric_name = true
        election = false
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "kube-state-metrics"
          job = "kube-state-metrics"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"
  - name: "node-exporter.conf"
    path: "/usr/local/datakit/conf.d/prom/node-exporter.conf"
    value: |
      [[inputs.prom]]
        urls = ["{{ datakit_node_exporter_url }}"]
        source = "node-exporter"
        interval = "15s"
        measurement_name = "node-exporter"
        keep_exist_metric_name = true
        election = false
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "node-exporter"
          job = "node-exporter"
          node = "{{ inventory_hostname | default('sit-k3s-v6') }}"
          nodename = "{{ inventory_hostname | default('sit-k3s-v6') }}"
          instance = "{{ inventory_hostname | default('sit-k3s-v6') }}"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"
  - name: "cadvisor.conf"
    path: "/usr/local/datakit/conf.d/prom/cadvisor.conf"
    value: |
      [[inputs.prom]]
        urls = ["https://127.0.0.1:10250/metrics/cadvisor"]
        source = "cadvisor"
        interval = "15s"
        measurement_name = "cadvisor"
        keep_exist_metric_name = true
        insecure_skip_verify = true
        election = false
        [inputs.prom.auth]
          type = "bearer_token"
          token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "cadvisor"
          job = "cadvisor"
          node = "{{ inventory_hostname | default('sit-k3s-v6') }}"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"
  - name: "kubelet.conf"
    path: "/usr/local/datakit/conf.d/prom/kubelet.conf"
    value: |
      [[inputs.prom]]
        urls = ["https://127.0.0.1:10250/metrics"]
        source = "kubelet"
        interval = "15s"
        measurement_name = "kubelet"
        keep_exist_metric_name = true
        insecure_skip_verify = true
        election = false
        [inputs.prom.auth]
          type = "bearer_token"
          token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
        [inputs.prom.tags]
          cluster = "{{ k8s_cluster_name | default('sit-k3s-v6') }}"
          environment = "{{ target_environment | default('dev') }}"
          env = "{{ target_env | default('sit') }}"
          service = "kubelet"
          job = "kubelet"
          node = "{{ inventory_hostname | default('sit-k3s-v6') }}"
          host = "{{ inventory_hostname | default('sit-k3s-v6') }}"

resources:
  requests:
    cpu: "{{ datakit_requests_cpu }}"
    memory: "{{ datakit_requests_memory }}"
  limits:
    cpu: "{{ datakit_limits_cpu }}"
    memory: "{{ datakit_limits_memory }}"
