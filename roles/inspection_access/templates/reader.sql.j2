BEGIN;
SET LOCAL lock_timeout='10s';
SET LOCAL statement_timeout='30s';
SELECT pg_advisory_xact_lock(721043110);
SELECT set_config('migration_access.before', md5(
 COALESCE((SELECT ROW(rolname,rolcanlogin,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls,rolinherit,rolconfig)::text FROM pg_roles WHERE rolname='{{ inspection_db_role }}'),'absent') ||
 COALESCE((SELECT string_agg(oid::text||COALESCE(relacl::text,''),',' ORDER BY oid) FROM pg_class WHERE relnamespace='public'::regnamespace),'') ||
 COALESCE((SELECT datacl::text FROM pg_database WHERE datname=current_database()),'') ||
 COALESCE((SELECT nspacl::text FROM pg_namespace WHERE nspname='public'),'') || COALESCE((SELECT string_agg(defaclacl::text,',' ORDER BY oid) FROM pg_default_acl),'')), true);
DO $reader$
BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='{{ inspection_db_role }}') THEN
  CREATE ROLE {{ inspection_db_role }} LOGIN PASSWORD NULL NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_authid WHERE rolname='{{ inspection_db_role }}' AND rolcanlogin AND rolpassword IS NULL
    AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit)
    OR EXISTS (SELECT 1 FROM pg_auth_members WHERE member=(SELECT oid FROM pg_roles WHERE rolname='{{ inspection_db_role }}'))
    OR EXISTS (SELECT 1 FROM pg_class WHERE relowner=(SELECT oid FROM pg_roles WHERE rolname='{{ inspection_db_role }}')) THEN
  RAISE EXCEPTION 'Existing migration identity has incompatible credentials, membership or ownership; manual review required';
 END IF;
 IF EXISTS (SELECT 1 FROM pg_proc p WHERE p.pronamespace='public'::regnamespace AND p.prosecdef
    AND has_function_privilege('{{ inspection_db_role }}',p.oid,'EXECUTE')) THEN
  RAISE EXCEPTION 'Executable security-definer routines require explicit review';
 END IF;
END $reader$;
ALTER ROLE {{ inspection_db_role }} SET default_transaction_read_only=on;
GRANT CONNECT ON DATABASE {{ inspection_database }} TO {{ inspection_db_role }};
GRANT USAGE ON SCHEMA public TO {{ inspection_db_role }};
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM {{ inspection_db_role }};
GRANT SELECT ON ALL TABLES IN SCHEMA public TO {{ inspection_db_role }};
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM {{ inspection_db_role }};
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO {{ inspection_db_role }};
{% for owner in inspection_database_owners %}
ALTER DEFAULT PRIVILEGES FOR ROLE {{ owner }} IN SCHEMA public GRANT SELECT ON TABLES TO {{ inspection_db_role }};
ALTER DEFAULT PRIVILEGES FOR ROLE {{ owner }} IN SCHEMA public GRANT SELECT ON SEQUENCES TO {{ inspection_db_role }};
{% endfor %}
DO $policies$
DECLARE tab record;
BEGIN
 FOR tab IN SELECT c.oid,c.relname FROM pg_class c WHERE c.relnamespace='public'::regnamespace
 AND c.relkind IN ('r','p') AND c.relrowsecurity LOOP
  IF EXISTS (SELECT 1 FROM pg_policy p WHERE p.polrelid=tab.oid AND NOT p.polpermissive
    AND p.polcmd IN ('r','*') AND (0::oid=ANY(p.polroles) OR (SELECT oid FROM pg_roles WHERE rolname='{{ inspection_db_role }}')=ANY(p.polroles))) THEN
   RAISE EXCEPTION 'Restrictive source policy requires explicit review';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_policy WHERE polrelid=tab.oid AND polname='inspection_select') THEN
   IF NOT EXISTS (SELECT 1 FROM pg_policy p WHERE p.polrelid=tab.oid AND p.polname='inspection_select'
     AND p.polcmd='r' AND p.polpermissive AND p.polroles=ARRAY[(SELECT oid FROM pg_roles WHERE rolname='{{ inspection_db_role }}')]
     AND pg_get_expr(p.polqual,p.polrelid)='true' AND p.polwithcheck IS NULL) THEN
    RAISE EXCEPTION 'Existing source reader policy differs; manual review required';
   END IF;
  ELSE
   EXECUTE format('CREATE POLICY inspection_select ON public.%I FOR SELECT TO {{ inspection_db_role }} USING(true)',tab.relname);
  END IF;
 END LOOP;
END $policies$;
DO $verify$
BEGIN
 IF has_schema_privilege('{{ inspection_db_role }}','public','CREATE') OR EXISTS (
 SELECT 1 FROM pg_class c WHERE c.relnamespace='public'::regnamespace AND c.relkind IN ('r','p') AND
 (has_table_privilege('{{ inspection_db_role }}',c.oid,'INSERT') OR has_table_privilege('{{ inspection_db_role }}',c.oid,'UPDATE') OR
  has_table_privilege('{{ inspection_db_role }}',c.oid,'DELETE') OR has_table_privilege('{{ inspection_db_role }}',c.oid,'TRUNCATE')))
 OR EXISTS (SELECT 1 FROM pg_class c WHERE c.relnamespace='public'::regnamespace
 AND CASE WHEN c.relkind='S' THEN has_sequence_privilege('{{ inspection_db_role }}',c.oid,'USAGE,UPDATE') ELSE false END) THEN
  RAISE EXCEPTION 'Effective public privileges would permit permanent writes';
 END IF;
END $verify$;
SELECT CASE WHEN current_setting('migration_access.before') = md5(
 COALESCE((SELECT ROW(rolname,rolcanlogin,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls,rolinherit,rolconfig)::text FROM pg_roles WHERE rolname='{{ inspection_db_role }}'),'absent') ||
 COALESCE((SELECT string_agg(oid::text||COALESCE(relacl::text,''),',' ORDER BY oid) FROM pg_class WHERE relnamespace='public'::regnamespace),'') ||
 COALESCE((SELECT datacl::text FROM pg_database WHERE datname=current_database()),'') ||
 COALESCE((SELECT nspacl::text FROM pg_namespace WHERE nspname='public'),'') || COALESCE((SELECT string_agg(defaclacl::text,',' ORDER BY oid) FROM pg_default_acl),'')) THEN 'unchanged' ELSE 'changed' END;
COMMIT;
