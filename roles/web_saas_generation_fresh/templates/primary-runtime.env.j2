SMTP_HOST={{ generation_primary_runtime.smtp.host }}
SMTP_PORT={{ generation_primary_runtime.smtp.port }}
SMTP_TLS_MODE={{ generation_primary_runtime.smtp.tls_mode }}
SMTP_USERNAME={{ generation_primary_smtp.username | to_json(ensure_ascii=false) | replace('$', '$$') }}
SMTP_PASSWORD={{ generation_primary_smtp.password | to_json(ensure_ascii=false) | replace('$', '$$') }}
SMTP_FROM={{ generation_primary_smtp.username | to_json(ensure_ascii=false) | replace('$', '$$') }}
GOOGLE_CLIENT_ID={{ (generation_primary_google.client_id if generation_primary_google.enabled | default(false) | bool else '') | to_json(ensure_ascii=false) | replace('$', '$$') }}
GOOGLE_CLIENT_SECRET={{ (generation_primary_google.client_secret if generation_primary_google.enabled | default(false) | bool else '') | to_json(ensure_ascii=false) | replace('$', '$$') }}
STRIPE_SECRET_KEY={{ generation_primary_stripe[generation_primary_runtime.stripe.secret_key] | to_json(ensure_ascii=false) | replace('$', '$$') }}
STRIPE_WEBHOOK_SECRET={{ generation_primary_stripe[generation_primary_runtime.stripe.webhook_key] | to_json(ensure_ascii=false) | replace('$', '$$') }}
