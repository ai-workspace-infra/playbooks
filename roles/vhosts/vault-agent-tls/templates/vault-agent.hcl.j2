vault {
  address = {{ vault_agent_tls_addr | to_json }}
}

auto_auth {
  method "token_file" {
    config = {
      token_file_path = {{ vault_agent_tls_token_file | to_json }}
    }
  }
}

template_config {
  static_secret_render_interval = {{ vault_agent_tls_refresh_interval | to_json }}
}

template {
  source               = {{ (vault_agent_tls_config_dir ~ '/tls.ctmpl') | to_json }}
  destination          = "/run/vault-agent/tls-version"
  perms                = "0600"
  error_on_missing_key = true

  exec {
    command = ["/usr/local/sbin/sync-vault-agent-caddy-tls"]
    timeout = "30s"
  }
}
