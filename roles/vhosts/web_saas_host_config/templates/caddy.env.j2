{# Managed by Ansible: roles/vhosts/web_saas_host_config
   只给 caddy 一个容器。不并进 secrets.env —— 那个文件被 postgres /
   accounts / billing / console 四个服务同时 env_file 引用, 而这个 token
   能改整个 Cloudflare zone 的解析记录, 没有理由让业务容器拿到它。 #}
# Managed by Ansible: roles/vhosts/web_saas_host_config
# Do not edit by hand — regenerated on every deploy.
CLOUDFLARE_DNS_API_TOKEN={{ web_saas_host_config_cloudflare_dns_api_token }}
# Caddy's tracing module exports gRPC. The in-network collector owns the
# translation to VictoriaTraces' public HTTP/protobuf endpoint.
OTEL_SERVICE_NAME=web-saas-caddy
OTEL_RESOURCE_ATTRIBUTES={{ web_saas_host_config_otel_resource_attributes }}
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG={{ web_saas_host_config_otel_sampling_ratio }}
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_METRICS_EXPORTER=none
