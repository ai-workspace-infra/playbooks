{# Managed by Ansible: roles/vhosts/web_saas_host_config

   本文件被渲染两次: 先 Jinja(这里), 再由容器 entrypoint 里的 envsubst。
   envsubst 不支持 ${VAR:-default} —— 那种写法会原样漏进最终文件。所以
   变量一律写朴素 ${VAR}, 需要默认值就在 Jinja 这一层给。 #}
mode: "server-agent"

log:
  level: info

auth:
  enable: true
  token:
    publicToken: "${AUTH_TOKEN_PUBLIC_TOKEN}"
    refreshSecret: "${AUTH_TOKEN_REFRESH_SECRET}"
    accessSecret: "${AUTH_TOKEN_ACCESS_SECRET}"
    accessExpiry: "1h"
    refreshExpiry: "168h"
  oauth:
    frontendUrl: "https://{{ web_saas_host_config_console_domain }}"
    github:
      clientId: "${GITHUB_CLIENT_ID}"
      clientSecret: "${GITHUB_CLIENT_SECRET}"
      redirectUrl: "https://{{ web_saas_host_config_accounts_domain }}/api/auth/oauth/callback/github"
    google:
      clientId: "${GOOGLE_CLIENT_ID}"
      clientSecret: "${GOOGLE_CLIENT_SECRET}"
      redirectUrl: "https://{{ web_saas_host_config_accounts_domain }}/api/auth/oauth/callback/google"

server:
  addr: ":8080"
  readTimeout: 15s
  writeTimeout: 15s
  publicUrl: "https://{{ web_saas_host_config_accounts_domain }}"
  allowedOrigins:
    - "https://{{ web_saas_host_config_console_domain }}"
    - "https://{{ web_saas_host_config_accounts_domain }}"
  tls:
    enabled: false
    certFile: ""
    keyFile: ""
    caFile: ""
    clientCAFile: ""
    redirectHttp: false

store:
  driver: "postgres"
  # All business services use the local TLS tunnel, including single-node deployments.
  # Use libpq key=value DSN so passwords containing /, +, or = are not
  # interpreted as URI syntax by the Go URL parser.
  #
  # 这里必须是 account_user, 不是 postgres。用超级用户连库不只是权限过大:
  # 它还会掩盖建表属主/授权的缺陷 —— accounts 以 postgres 跑得好好的, 同库的
  # billing 以 account_user 连进来就是
  #   permission denied for table traffic_stat_checkpoints (SQLSTATE 42501)。
  # 两个服务走同一个角色, 权限问题才会在第一个服务上就暴露出来。
  dsn: "host=stunnel-client port=15432 dbname=account user=${ACCOUNT_PG_USER} password=${ACCOUNT_PG_PASSWORD} sslmode=disable"
  maxOpenConns: 30
  maxIdleConns: 10

session:
  ttl: 24h
