{# Managed by Ansible: roles/vhosts/web_saas_host_config

   这个 Caddy 跑在 compose 栈里(容器 web-saas-caddy), 与主机上那个
   systemd caddy 是两回事 —— 不要把本文件和 roles/vhosts/caddy 的
   /etc/caddy/Caddyfile 混淆。upstream 一律写 compose 网络内的服务名。

   两种签发模式:
     DNS-01 (有 CLOUDFLARE_DNS_API_TOKEN): 一个泛域名 site block, 按 host
       分流。DNS-01 不需要 A 记录已经指向本机, 所以"先部署、后切 DNS"的
       顺序下也签得出证书; 且三个子域共用一张 *.<base> 证书。
     HTTP-01 (没有 token): 退回逐域名 site block, 与历史行为一致。
       这条路径要求 DNS 已经指过来, 否则签不出证书。

   DNS-01 需要 caddy-dns/cloudflare 模块 —— 官方 caddy 镜像不含它, 用的是
   ghcr.io/ai-workspace-infra/caddy-cloudflare(artifacts 仓构建)。 #}
{
	admin off
}

{% if (web_saas_host_config_use_restored_tls | default(false) | bool) or (web_saas_host_config_acme_dns_enabled | bool) %}
{{ web_saas_host_config_wildcard_domain }} {
{% if web_saas_host_config_use_restored_tls | default(false) | bool %}
	{# 从 Vault 恢复下来的泛域名证书就在磁盘上, 直接指过去 —— 这条路完全不碰
	   ACME, 所以重建多少次都不消耗 Let's Encrypt 的签发额度。这才是"有效期内
	   无限复用"真正落地的地方: 不是"让 Caddy 发现证书已在"(那要求伪造它的
	   内部目录布局, 换个版本就对不上), 而是根本不给它签发的机会。
	   证书临近到期时平台侧会主动跳过恢复, 磁盘上没有文件, 这里自动退回
	   下面的 ACME 分支去签新的。 #}
	tls {{ web_saas_host_config_domain_tls_fullchain }} {{ web_saas_host_config_domain_tls_key }}
{% else %}
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
{% endif %}

	encode zstd gzip

	{# console 域下的 /api/auth/* 必须留给 console 自己 —— 它不是 accounts 的
	   API 前缀, 而是 Next 的 BFF 路由(src/app/api/auth/**)。BFF 做两件 Go 服务
	   做不到的事: 把浏览器的 xc_session cookie 翻成 Authorization: Bearer, 以及
	   把 BFF 路径翻成 Go 路径(/mfa/setup → /mfa/totp/provision)。曾经这里有一条
	   把该前缀转给 accounts:8080 的规则, 结果 MFA 绑定四个端点全废(setup 404、
	   status/disable 401、verify 语义错) —— 见 docs/cases/runbooks/。
	   console 自己要访问 accounts 时走 authUrl(accounts-uat 这个 vhost), 不靠本域。 #}
	@accounts host {{ web_saas_host_config_accounts_domain }}
	handle @accounts {
		tracing {
			span http.server.request
		}
		reverse_proxy accounts:8080 {
			header_up X-Forwarded-Host {{ web_saas_host_config_accounts_forwarded_host }}
		}
	}

	@console host {{ web_saas_host_config_console_domain }}
	handle @console {
		tracing {
			span http.server.request
		}
		reverse_proxy console:3000
	}

	{# agent-proxy/Vector 通过这个入口投递 Billing 快照。域名和 agent CIDR
	   都由部署流水线提供时才生成, Caddy 先做源 IP 限制, Billing ingest
	   再用与 Accounts 相同的 INTERNAL_SERVICE_TOKEN 做 Bearer 认证。 #}
{% if web_saas_host_config_billing_domain | trim | length > 0 and web_saas_host_config_billing_allowed_cidrs | trim | length > 0 %}
	@billing host {{ web_saas_host_config_billing_domain }}
	handle @billing {
		@billing_agent remote_ip {{ web_saas_host_config_billing_allowed_cidrs }}
		handle @billing_agent {
			tracing {
				span http.server.request
			}
			reverse_proxy billing:8081 {
				header_up X-Forwarded-Host {host}
			}
		}
		respond "billing ingress is restricted to agent-proxy" 403
	}
{% endif %}

	{# 泛域名会把 <base> 下所有子域都揽进来, 包括本机并不打算服务的那些。
	   没有兜底它们会落在所有 handle 之外、拿到一个空响应; 显式 abort 让
	   "这个域名本机不服务"成为一个明确结果而不是一个可疑的空白页。 #}
	handle {
		abort
	}
}
{% else %}
https://{{ web_saas_host_config_console_domain }} {
	encode zstd gzip

	# /api/auth/* 不做分流: 那是 console 自己的 Next BFF 路由, 不是 accounts 的
	# API 前缀。理由同 DNS-01 分支上面那段注释。
	handle {
		tracing {
			span http.server.request
		}
		reverse_proxy console:3000
	}
}

https://{{ web_saas_host_config_accounts_domain }} {
	encode zstd gzip
	tracing {
		span http.server.request
	}
	reverse_proxy accounts:8080 {
		header_up X-Forwarded-Host {{ web_saas_host_config_accounts_forwarded_host }}
	}
}

{% if web_saas_host_config_billing_domain | trim | length > 0 and web_saas_host_config_billing_allowed_cidrs | trim | length > 0 %}
https://{{ web_saas_host_config_billing_domain }} {
	encode zstd gzip
	@billing_agent remote_ip {{ web_saas_host_config_billing_allowed_cidrs }}
	handle @billing_agent {
		tracing {
			span http.server.request
		}
		reverse_proxy billing:8081 {
			header_up X-Forwarded-Host {host}
		}
	}
	respond "billing ingress is restricted to agent-proxy" 403
}
{% endif %}
{% endif %}
