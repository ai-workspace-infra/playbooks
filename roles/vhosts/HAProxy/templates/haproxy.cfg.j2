global
    log /dev/log local0 warning
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    nbthread {{ haproxy_nbthread }}

    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-options prefer-client-ciphers no-sslv3 no-tlsv10 no-tlsv11
    tune.ssl.default-dh-param 2048
    tune.bufsize {{ haproxy_bufsize }}
    tune.h2.initial-window-size {{ haproxy_h2_initial_window_size }}

defaults
    log     global
    mode    http
    option  dontlognull
    option  dontlog-normal
    timeout connect 5s
    timeout client  {{ haproxy_timeout_tunnel }}
    timeout server  {{ haproxy_timeout_tunnel }}
    timeout tunnel  {{ haproxy_timeout_tunnel }}
    timeout http-keep-alive 60s
    timeout http-request 15s

frontend http_in
    bind :::80 v4v6
    http-request redirect scheme https code 308 unless { ssl_fc }

frontend https_in
    bind :::443 v4v6 ssl crt {{ haproxy_pem_path }} alpn h2,http/1.1

    acl host_allowed hdr(host) -i {{ haproxy_vhosts | join(' ') }}

    acl is_exp_xhttp path_beg /xray-exporter/xhttp/
    acl is_exp_tcp   path_beg /xray-exporter/tcp/
    acl is_xhttp     path -m reg ^/split(/.*)?$

    use_backend be_exporter_xhttp if host_allowed is_exp_xhttp
    use_backend be_exporter_tcp   if host_allowed is_exp_tcp
    use_backend be_xray_xhttp     if host_allowed is_xhttp
    default_backend be_default

backend be_xray_xhttp
    mode http
    http-request set-path /split/ if { path /split }
    http-request set-query "%[query,regsub('(^|&)x_padding=[^&]*','',g),regsub('^&','')]" if { query -m sub x_padding= }
    server xray {{ haproxy_xhttp_unix_socket }} proto h2

backend be_exporter_xhttp
    mode http
    http-request replace-path /xray-exporter/xhttp/(.*) /\1
    server exp_xhttp {{ haproxy_exporter_xhttp_upstream }}

backend be_exporter_tcp
    mode http
    http-request replace-path /xray-exporter/tcp/(.*) /\1
    server exp_tcp {{ haproxy_exporter_tcp_upstream }}

backend be_default
    mode http
    http-request return status 200 content-type "text/plain; charset=utf-8" string "{{ haproxy_default_response }}"

frontend stats
    mode http
    bind {{ haproxy_stats_listen }}
{% if haproxy_legacy_metrics_listen | default('', true) | length > 0 %}
    bind {{ haproxy_legacy_metrics_listen }}
{% endif %}
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats refresh 10s
