{
  "log": {
    "loglevel": "info"
  },
  "routing": {
    "rules": []
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 51830,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "{{ xray_remote_domain }}",
        "port": 51820,
        "network": "udp"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ xray_remote_domain }}",
            "port": {% if xconnect_transport_kind | default('') == 'vless-xhttp' %}{{ xconnect_transport_port }}{% else %}{{ xray_main_port }}{% endif %},
            "users": [
              {
                "id": "{{ xray_uuid }}",
                "encryption": "none"{% if xconnect_transport_kind | default('') != 'vless-xhttp' %},
                "flow": "xtls-rprx-vision"
                {% endif %}
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "{% if xconnect_transport_kind | default('') == 'vless-xhttp' %}xhttp{% else %}tcp{% endif %}",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{{ xray_remote_domain }}",
          "allowInsecure": false,
          "fingerprint": "chrome"
        }{% if xconnect_transport_kind | default('') == 'vless-xhttp' %},
        "xhttpSettings": {
          "path": "{{ xconnect_transport_path }}",
          "mode": "{{ xconnect_transport_mode }}"{% if xconnect_transport_host | default('') | trim %},
          "host": "{{ xconnect_transport_host }}"{% endif %}
        }{% endif %}
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
