{
    "log": {
        "loglevel": "warning"
    },
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {
                "type": "field",
                "ip": [
                    "geoip:cn"
                ],
                "outboundTag": "block"
            }
        ]
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": {% if xconnect_transport_kind | default('') == 'vless-xhttp' %}{{ xconnect_transport_port }}{% else %}{{ xray_main_port }}{% endif %},
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "{{ xray_uuid }}"{% if xconnect_transport_kind | default('') != 'vless-xhttp' %},
                        "flow": "xtls-rprx-vision"
                        {% endif %}
                    }
                ],
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": "8001",
                        "xver": 1
                    },
                    {
                        "alpn": "h2",
                        "dest": "8002",
                        "xver": 1
                    }
                ]
            },
            "streamSettings": {
                "network": "{% if xconnect_transport_kind | default('') == 'vless-xhttp' %}xhttp{% else %}tcp{% endif %}",
                "security": "tls",
                "tlsSettings": {
                    "rejectUnknownSni": true,
                    "minVersion": "1.2",
                    "certificates": [
                        {
                            "ocspStapling": 3600,
                            "certificateFile": "{{ xray_cert_path }}",
                            "keyFile": "{{ xray_key_path }}"
                        }
                    ]
                }{% if xconnect_transport_kind | default('') == 'vless-xhttp' %},
                "xhttpSettings": {
                    "path": "{{ xconnect_transport_path }}",
                    "mode": "{{ xconnect_transport_mode }}"{% if xconnect_transport_host | default('') | trim %},
                    "host": "{{ xconnect_transport_host }}"{% endif %}
                }{% endif %}
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ]
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct"
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "policy": {
        "levels": {
            "0": {
                "handshake": 2,
                "connIdle": 120
            }
        }
    }
}
