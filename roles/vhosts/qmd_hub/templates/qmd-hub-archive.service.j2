[Unit]
Description=QMD Hub daily L3 archive ({{ qmd_hub_archive_backend }})
After=network-online.target

[Service]
Type=oneshot
User={{ qmd_hub_user }}
Group={{ qmd_hub_group }}
ExecStart={{ qmd_hub_root }}/bin/qmd-hub-archive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ qmd_hub_root }}
