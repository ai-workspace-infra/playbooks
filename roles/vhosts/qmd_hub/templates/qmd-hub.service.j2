[Unit]
Description=QMD Hub (Hub-Spoke centre, L1 QMD + L2 PG)
After=network-online.target{% if qmd_hub_pg_enabled | bool %} postgresql@{{ qmd_hub_pg_version }}-{{ qmd_hub_pg_cluster }}.service{% endif %}

Wants=network-online.target

[Service]
Type=simple
User={{ qmd_hub_user }}
Group={{ qmd_hub_group }}
WorkingDirectory={{ qmd_hub_root }}
ExecStart={{ qmd_hub_root }}/bin/qmd-hub-serve
Restart=on-failure
RestartSec=5
MemoryMax={{ qmd_hub_memory_max }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ qmd_hub_root }}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
