mode: "agent"

log:
  level: {{ agent_log_level }}

agent:
  id: "{{ agent_id }}"
  region: {{ agent_region | to_json }}
  pool: {{ agent_pool | to_json }}
  resourceClass: {{ agent_resource_class | to_json }}
{% if agent_custom_allow_free is defined %}
  customAllowFree: {{ agent_custom_allow_free | bool | lower }}
{% endif %}
{% if agent_allowed_emails is defined %}
  allowedEmails: {{ agent_allowed_emails | to_json }}
{% endif %}
  teamId: {{ agent_team_id | to_json }}
  entryPoint: {{ agent_entry_point | to_json }}
  openToUsers: {{ agent_open_to_users | bool | lower }}
  controllerUrl: "{{ agent_controller_url }}"
  apiToken: "{{ agent_api_token }}"
  httpTimeout: {{ agent_http_timeout }}
  statusInterval: {{ agent_status_interval }}
  syncInterval: {{ agent_sync_interval }}
  tls:
    insecureSkipVerify: {{ agent_tls_insecure_skip_verify | lower }}

billing:
  enabled: {{ agent_billing_enabled | lower }}
  baseURL: "{{ agent_billing_base_url }}"
  httpTimeout: {{ agent_billing_http_timeout }}
  collectInterval: {{ agent_billing_collect_interval }}
  reconcileInterval: {{ agent_billing_reconcile_interval }}

{% if xray_enabled %}
xray:
  sync:
    enabled: true
    interval: {{ xray_sync_interval }}
    targets:
{% if xray_merged_mode | default(false) | bool %}
      - name: "proxy"
        outputPath: "{{ xray_config_path }}"
        templatePath: "{{ xray_template_dir }}/xray.proxy.template.json"
        validateCommand:
          - "{{ xray_binary_path }}"
          - "run"
          - "-test"
          - "-config"
          - "{config}"
        restartCommand:
          - "systemctl"
          - "reload-or-restart"
          - "xray.service"
        dynamicUsers:
          enabled: false
{% else %}
      - name: "xhttp"
        outputPath: "{{ xray_config_path }}"
        templatePath: "{{ xray_template_dir }}/xray.xhttp.template.json"
        validateCommand: []
        restartCommand:
          - "systemctl"
          - "restart"
          - "xray.service"
{% if xray_dynamic_users_enabled | default(true) | bool %}
        dynamicUsers:
          enabled: true
          executable: "{{ xray_binary_path }}"
          server: "{{ xray_xhttp_api_server | default('127.0.0.1:' ~ (xray_xhttp_api_port | default(10086) | string)) }}"
{% endif %}
      - name: "tcp"
        outputPath: "{{ xray_tcp_config_path }}"
        templatePath: "{{ xray_template_dir }}/xray.tcp.template.json"
        validateCommand: []
        restartCommand:
          - "systemctl"
          - "restart"
          - "xray-tcp.service"
{% if xray_dynamic_users_enabled | default(true) | bool %}
        dynamicUsers:
          enabled: true
          executable: "{{ xray_binary_path }}"
          server: "{{ xray_tcp_api_server | default('127.0.0.1:' ~ (xray_tcp_api_port | default(10087) | string)) }}"
{% endif %}
{% endif %}
{% endif %}
