[Unit]
Description={{ agent_proxy_service_description }}
After=network.target

[Service]
Type=simple
WorkingDirectory={{ agent_proxy_data_dir }}
ExecStart={{ agent_proxy_binary_path }} -config {{ agent_proxy_config_path }}
Restart=always
User={{ agent_proxy_user }}
Group={{ agent_proxy_group }}

[Install]
WantedBy=multi-user.target
