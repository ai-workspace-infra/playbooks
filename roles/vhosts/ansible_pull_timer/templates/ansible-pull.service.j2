[Unit]
Description={{ ansible_pull_timer_description }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={{ ansible_pull_path }}
Environment=KUBECONFIG={{ ansible_pull_kubeconfig }}
Environment=ANSIBLE_HOST_KEY_CHECKING=False
EnvironmentFile=-{{ ansible_pull_environment_file | default('/etc/ansible-pull/gitops-declaration.env') }}
ExecStart={{ ansible_pull_executable }} -U {{ ansible_pull_repo_url }} -C {{ ansible_pull_checkout }} -d {{ ansible_pull_checkout_dir }} -i {{ ansible_pull_inventory }} {{ ansible_pull_playbook }}{% if ansible_pull_extra_vars | default('', true) | length > 0 %} -e "{{ ansible_pull_extra_vars }}"{% endif %}
TimeoutStartSec={{ ansible_pull_timeout_sec }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
