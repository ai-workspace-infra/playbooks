# Managed by Ansible role qmd_standalone (no secret values; file paths only).
QMD_SPOKE_ROOT={{ qmd_standalone_root }}
QMD_SPOKE_ORIGIN={{ qmd_standalone_origin }}
QMD_HUB_URL={{ qmd_standalone_hub_url }}
QMD_HUB_TOKEN_FILE={{ qmd_standalone_hub_token_file }}
QMD_HUB_TRANSPORT={{ qmd_standalone_hub_transport }}
QMD_HUB_TUNNEL_SSH={{ qmd_standalone_hub_tunnel_ssh }}
QMD_HUB_TUNNEL_TARGET={{ qmd_standalone_hub_tunnel_target }}
QMD_HUB_SSH_KEY={{ qmd_standalone_hub_ssh_key }}
QMD_PUSH_COLLECTIONS="{% for name, c in qmd_standalone_collections | dictsort if c.push | default(false) %}{{ name }}={{ c.path }} {% endfor %}"
QMD_GIT_SOURCES="{{ qmd_standalone_git_sources | join(' ') }}"
