{% if xray_merged_mode | default(false) | bool %}
[Unit]
Description=Xray Service (XHTTP + TCP + Embedded In-Memory Exporter)
Documentation=https://github.com/xtls
After=network.target nss-lookup.target

[Service]
User={{ xray_xhttp_service_user }}
Group={{ xray_xhttp_service_group }}
SupplementaryGroups=caddy {{ xray_access_log_group }}
EnvironmentFile=-{{ xray_exporter_env_file | default('/etc/xray-exporter.env') }}
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/xray run -config {{ xray_config_path }} -listen {{ xray_exporter_listen_addr | default('127.0.0.1:8080') }} -user-traffic-metrics -log-path {{ xray_access_log_path }} -geoip-dir {{ xray_exporter_snapshot_store_dir | default('/var/lib/xray-exporter') }} -disable-geoip-download -node-id {{ inventory_hostname }} -snapshot-store-path {{ xray_exporter_snapshot_store_dir | default('/var/lib/xray-exporter') }}/proxy-snapshots.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray/

[Install]
WantedBy=multi-user.target
{% else %}
[Unit]
Description=Xray Service (XHTTP)
Documentation=https://github.com/xtls
After=network.target nss-lookup.target

[Service]
User={{ xray_xhttp_service_user }}
Group={{ xray_xhttp_service_group }}
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/xray run -config {{ xray_config_path }}
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray/

[Install]
WantedBy=multi-user.target
{% endif %}
