{{ ai_aggregator_spec.entrypoint.domain }} {
    @api {
        remote_ip {{ ai_aggregator_spec.entrypoint.source_cidrs | join(' ') }}
        path /v1/models /v1/responses /v1/chat/completions /v1/messages /v1/messages/* /v1beta/*
    }

    handle @api {
        reverse_proxy {{ ai_aggregator_spec.new_api.bind_address }}:{{ ai_aggregator_spec.new_api.port }}
    }

    @admin {
        remote_ip {{ ai_aggregator_spec.entrypoint.source_cidrs | join(' ') }}
        path / /console* /admin*
    }

    handle @admin {
{% if ai_aggregator_caddy_basic_auth_hash is defined and ai_aggregator_caddy_basic_auth_hash | length > 0 %}
        basic_auth {
            admin {{ ai_aggregator_caddy_basic_auth_hash }}
        }
{% endif %}
        reverse_proxy {{ ai_aggregator_spec.new_api.bind_address }}:{{ ai_aggregator_spec.new_api.port }}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    respond "forbidden" 403
}

{{ ai_aggregator_spec.entrypoint.direct_api_domain }} {
    @direct_api {
        remote_ip {{ ai_aggregator_spec.entrypoint.source_cidrs | join(' ') }}
        path /v1/*
    }

    handle @direct_api {
        reverse_proxy {{ ai_aggregator_spec.litellm.bind_address }}:{{ ai_aggregator_spec.litellm.port }}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    respond "forbidden" 403
}
