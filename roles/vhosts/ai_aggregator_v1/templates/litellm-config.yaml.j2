# Non-sensitive LiteLLM configuration. Provider credentials are injected as
# environment variables from Vault at runtime.
model_list:
{% if ai_aggregator_spec.litellm.models | default([]) | length > 0 %}
{% for model in ai_aggregator_spec.litellm.models %}
  - model_name: {{ model.id }}
    litellm_params:
      model: {{ model.backend_model | default(model.id) }}
      api_base: os.environ/{{ model.api_base_env | default((model.provider | upper | regex_replace('[^A-Z0-9]', '_')) ~ '_API_BASE') }}
      api_key: os.environ/{{ model.api_key_env | default((model.provider | upper | regex_replace('[^A-Z0-9]', '_')) ~ '_API_KEY') }}
{% endfor %}
{% else %}
  - model_name: openai-api
    litellm_params:
      model: openai/*
      api_base: os.environ/OPENAI_API_BASE
      api_key: os.environ/OPENAI_API_KEY
  - model_name: anthropic-api
    litellm_params:
      model: anthropic/*
      api_base: os.environ/ANTHROPIC_API_BASE
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: xai-api
    litellm_params:
      model: xai/*
      api_base: os.environ/XAI_API_BASE
      api_key: os.environ/XAI_API_KEY
{% endif %}

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL

litellm_settings:
  json_logs: true
  drop_params: false
  callbacks:
    - prometheus
  # LiteLLM binds to loopback and Caddy does not route /metrics. Allow the
  # local Vector agent to scrape without putting the master key in its config.
  require_auth_for_metrics_endpoint: false
  prometheus_exclude_labels:
    - hashed_api_key
    - api_key_alias
    - user
    - user_email
    - team
    - team_alias
    - end_user
    - client_ip
    - user_agent
