# Non-sensitive CPA configuration. OAuth material is restored at runtime into
# {{ ai_aggregator_runtime_root }}/cpa/{{ item.id }}/auth by the auth role.
host: {{ item.bind_address }}
port: {{ item.port }}
auth-dir: {{ ai_aggregator_runtime_root }}/cpa/{{ item.id }}/auth
remote-management:
  allow-remote: false
  key: ""

