# Non-sensitive CPA configuration. OAuth material is restored at runtime into
# {{ ai_aggregator_runtime_root }}/cpa/{{ item.id }}/auth by the auth role.
host: {{ item.bind_address }}
port: {{ item.port }}
auth-dir: {{ item.local_auth_dir if ai_aggregator_adapter == 'apisix' else ai_aggregator_runtime_root ~ '/cpa/' ~ item.id ~ '/auth' }}
remote-management:
  allow-remote: false
  key: ""
