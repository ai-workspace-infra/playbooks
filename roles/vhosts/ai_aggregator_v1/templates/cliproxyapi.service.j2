[Unit]
Description=CLIProxyAPI {{ item.id }}
After=network-online.target
Wants=network-online.target
After=ai-aggregator-runtime.mount
Requires=ai-aggregator-runtime.mount
ConditionPathExists={{ ai_aggregator_runtime_root }}/cpa/{{ item.id }}/auth

[Service]
Type=simple
User=ai-cpa-{{ item.id }}
Group={{ ai_aggregator_service_group }}
WorkingDirectory={{ ai_aggregator_root }}/cpa/{{ item.id }}
ExecStart={{ ai_aggregator_cliproxyapi_binary }} --config {{ ai_aggregator_root }}/cpa/{{ item.id }}/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ ai_aggregator_runtime_root }}/cpa/{{ item.id }}

[Install]
WantedBy=multi-user.target
