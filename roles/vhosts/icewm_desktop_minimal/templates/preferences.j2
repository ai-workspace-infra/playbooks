# AI Desktop IceWM preferences
# Keep the session predictable over XRDP and usable from a local X11 session.
TaskBarShowClock=1
TaskBarShowAPMStatus=0
TaskBarShowNetworkStatus=0
TaskBarShowWindowList=1
TaskBarShowWorkspaces=0
ShowDesktop=1
FocusOnClick=1
SmartPlacement=1
CenterLarge=1
DoubleBuffer=1
DesktopBackgroundColor="#e2ebf8"
DesktopBackgroundImage="/usr/share/icewm/xworktech-wallpaper.png"
DesktopBackgroundScaled=1
DesktopBackgroundCenter=1
WorkspaceNames="Desktop"
