# Managed by Ansible (roles/vhosts/k3s-cluster-server)
# Memory limit and Go runtime garbage collection tuning for K3s server
{% if k3s_platform_enable_mem_tuning | default(true) | bool %}
GOMEMLIMIT={{ k3s_platform_gomemlimit | default('768MiB') }}
GOGC={{ k3s_platform_gogc | default('50') }}
{% endif %}
{% for key, val in (k3s_platform_service_extra_env | default({})).items() %}
{{ key }}={{ val }}
{% endfor %}
