modules:
  https_ssl:
    prober: http
    # 探测超时必须明显小于抓取间隔。原先 15s 等于 15s 的抓取周期, 一次慢握手
    # 就会与下一轮重叠, goroutine 与堆随轮次叠加(单机 heap_sys 曾到 380MiB)。
    timeout: {{ blackbox_https_ssl_timeout | default('5s') }}
    http:
      method: GET
      # TLS handshake failures still cause probe_success to be 0. Redirects and
      # protected endpoints remain valid certificate-expiry targets.
      valid_status_codes: [200, 301, 302, 307, 308, 401, 403, 404]
      preferred_ip_protocol: ip4

  http_dl_download:
    prober: http
    timeout: 5s
    http:
      method: GET
      follow_redirects: true
      valid_status_codes: [200, 302]
      headers:
        Host: {{ dl_business_host | default('dl.svc.plus') }}
      tls_config:
        server_name: {{ dl_business_host | default('dl.svc.plus') }}
        insecure_skip_verify: false
      # fail_if_body_not_matches_regexp:
      #   - "(?i)\\.zip|\\.tar\\.gz|manifest"

  http_2xx:
    prober: http
    timeout: 5s
    http:
      method: GET
      follow_redirects: false
      valid_status_codes: [200]

  tcp_connect:
    prober: tcp
    timeout: 3s
