[Unit]
Description=Synchronize XConnect One {{ xconnect_one_environment }} signed configuration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ xconnect_one_binary_path }} sync --watch --interval={{ xconnect_one_sync_interval_seconds | int }}s --state-dir {{ xconnect_one_state_dir }}
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{ xconnect_one_state_dir }} /run /etc/wireguard

[Install]
WantedBy=multi-user.target
