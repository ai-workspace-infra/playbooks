[Unit]
Description=XWorkmate WebRTC Remote Desktop Server
After=network.target xrdp.service

[Service]
Type=simple
User={{ webrtc_desktop_bridge_user }}
Group={{ webrtc_desktop_bridge_user }}
Environment="XRD_LISTEN={{ webrtc_desktop_bridge_listen }}"
{% if webrtc_desktop_bridge_display | length > 0 %}
Environment="XRD_DISPLAY={{ webrtc_desktop_bridge_display }}"
Environment="DISPLAY={{ webrtc_desktop_bridge_display }}"
{% endif %}
{% if webrtc_desktop_bridge_token_file | length > 0 %}
Environment="XRD_TOKEN_FILE={{ webrtc_desktop_bridge_token_file }}"
{% endif %}
{% if webrtc_desktop_bridge_nat1to1_ip | default('') | length > 0 %}
Environment="XRD_NAT1TO1_IP={{ webrtc_desktop_bridge_nat1to1_ip }}"
{% endif %}
{% if webrtc_desktop_bridge_accounts_url | default('') | length > 0 %}
Environment="XRD_ACCOUNTS_URL={{ webrtc_desktop_bridge_accounts_url }}"
{% endif %}
{% if webrtc_desktop_bridge_login_url | default('') | length > 0 %}
Environment="XRD_LOGIN_URL={{ webrtc_desktop_bridge_login_url }}"
{% endif %}
{% if webrtc_desktop_bridge_allowed_roles | default('') | length > 0 %}
Environment="XRD_ALLOWED_ROLES={{ webrtc_desktop_bridge_allowed_roles }}"
{% endif %}
{% if webrtc_desktop_bridge_allowed_emails | default('') | length > 0 %}
Environment="XRD_ALLOWED_EMAILS={{ webrtc_desktop_bridge_allowed_emails }}"
{% endif %}
ExecStart={{ webrtc_desktop_bridge_binary_dest }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
