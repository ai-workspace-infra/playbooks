# Root-owned launcher admits only dsh-acp/dsh-sdk plus canonical UUID.
# The launcher validates all arguments again; no shell or arbitrary systemd-run.
{{ xworkmate_workers_gateway_user }} ALL=(root) NOPASSWD: {{ xworkmate_workers_launcher }} dsh-acp *, {{ xworkmate_workers_launcher }} dsh-sdk *
{{ xworkmate_workers_gateway_user }} ALL=(root) NOPASSWD: {{ xworkmate_workers_launcher }} export dsh-acp *, {{ xworkmate_workers_launcher }} export dsh-sdk *
{{ xworkmate_workers_gateway_user }} ALL=(root) NOPASSWD: {{ xworkmate_workers_launcher }} cancel dsh-acp *, {{ xworkmate_workers_launcher }} cancel dsh-sdk *
