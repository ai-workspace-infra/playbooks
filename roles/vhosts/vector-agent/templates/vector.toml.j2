{# 全局 HTTPS 可用性/证书探活已收口到集群侧(prod-k3s-v6 / sit-k3s-v6 的
   observability-agent blackboxExporter + vmagent), 边缘主机不再对全球 9 个域名
   发探测。保留能力但默认关闭: 需要在本机排障时用
   vector_blackbox_probe_enabled=true 打开, 周期为 blackbox_probe_interval_secs
   (默认 3600s), 避免再次以 15s 频率打满外部请求。 #}
{% set blackbox_probe_enabled = vector_blackbox_probe_enabled | default(false) | bool %}
{% if blackbox_probe_enabled %}
{% set ssl_targets = blackbox_ssl_targets | default(blackbox_exporter_role_defaults.blackbox_ssl_targets | default([])) %}
{% else %}
{% set ssl_targets = [] %}
{% endif %}
{% set blackbox_probe_interval = (blackbox_probe_interval_secs | default(3600, true)) | int %}
{% for target in ssl_targets %}
{% set target_id = target.name | regex_replace('[^A-Za-z0-9_]', '_') %}
[sources.blackbox_{{ target_id }}_ssl]
type = "prometheus_scrape"
endpoints = ["http://127.0.0.1:9115/probe?module=https_ssl&target={{ target.url | urlencode }}"]
scrape_interval_secs = {{ blackbox_probe_interval }}
scrape_timeout_secs = 10

[transforms.blackbox_{{ target_id }}_labels]
type = "remap"
inputs = ["blackbox_{{ target_id }}_ssl"]
source = '''
.tags.instance = "{{ vector_observability_node_identity }}"
.tags.node = "{{ vector_observability_node_identity }}"
.tags.host = "{{ obs_host }}"
.tags.job = "blackbox"
.tags.service = "blackbox"
.tags.module = "https_ssl"
{# company/project/env 原本写死成 svc.plus + production。UAT 主机因此把自己的
   指标当成生产数据送进集中式可观测, 在看板上与真生产无法区分。这三个标签
   必须跟着被探测的环境走 —— sink 仍然是同一个 observability.svc.plus, 那是
   有意的集中收集, 区分靠标签而不是靠分开的后端。 #}
.tags.company = "{{ blackbox_probe_domain_base | default('svc.plus') }}"
.tags.project = "{{ blackbox_probe_domain_base | default('svc.plus') }}"
.tags.environment = "{{ blackbox_probe_env | default(vector_observability_environment) }}"
.tags.env = "{{ blackbox_probe_env | default('production') }}"
.tags.provider = "{{ vector_observability_provider }}"
.tags.region = {{ obs_region | to_json }}
.tags.resource_id = {{ obs_resource_id | to_json }}
.tags.runtime_form = {{ obs_runtime_form | to_json }}
.tags.resource_key = {{ obs_resource_key | to_json }}
.tags.service_domain = "{{ vector_observability_node_identity }}"
.tags.name = "{{ target.name }}"
.tags.target = "{{ target.url }}"
'''
{% endfor %}

{% if vector_billing_ingest_enabled | bool and xray_exporter_enabled %}
# Normalized snapshots are pushed by xray-exporter and fan out through Vector
# to Billing. Grafana continues to receive the Prometheus stream below.
[sources.xray_snapshot_input]
type = "http_server"
address = "{{ vector_billing_ingest_address }}"
decoding.codec = "json"

[sinks.billing_snapshot_ingest]
type = "http"
inputs = ["xray_snapshot_input"]
uri = "{{ vector_billing_ingest_url }}"
method = "post"
encoding.codec = "json"
[sinks.billing_snapshot_ingest.request]
headers.Authorization = "Bearer SECRET[local_secret.billing_token]"
retry_initial_backoff_secs = 5
retry_max_duration_secs = 3600
rate_limit_duration_secs = 1
rate_limit_num = {{ vector_sink_rate_limit_num | default(5) }}
[sinks.billing_snapshot_ingest.tls]
verify_certificate = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}
verify_hostname = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}
[sinks.billing_snapshot_ingest.healthcheck]
enabled = false
[sinks.billing_snapshot_ingest.batch]
max_events = 1
timeout_secs = 5
[sinks.billing_snapshot_ingest.buffer]
type = "disk"
# Persistent 512 MiB disk buffer to absorb traffic and network spikes
max_size = {{ vector_disk_buffer_max_bytes | default(536870912) }}
{% endif %}

[sinks.prometheus_remote]
type = "prometheus_remote_write"
{% set remote_inputs = ["add_labels"] %}
{% if vector_caddy_metrics_enabled | default(false) | bool %}
{% set _ = remote_inputs.append("add_caddy_labels") %}
{% endif %}
{% if (vector_caddy_metrics_enabled | default(false) | bool) and (vector_caddy_health_probe_enabled | default(true) | bool) %}
{% set _ = remote_inputs.append("caddy_up_labels") %}
{% endif %}
{% if vector_haproxy_metrics_enabled | default(false) | bool %}
{% set _ = remote_inputs.append("add_haproxy_labels") %}
{% endif %}
{% if (vector_haproxy_metrics_enabled | default(false) | bool) and (vector_haproxy_health_probe_enabled | default(true) | bool) %}
{% set _ = remote_inputs.append("haproxy_up_labels") %}
{% endif %}
{% if vector_fluxgate_metrics_enabled | default(false) | bool %}
{% set _ = remote_inputs.append("add_fluxgate_labels") %}
{% endif %}
{% if (vector_fluxgate_metrics_enabled | default(false) | bool) and (vector_fluxgate_health_probe_enabled | default(true) | bool) %}
{% set _ = remote_inputs.append("fluxgate_up_labels") %}
{% endif %}
{% if vector_xhttp_monitoring_enabled | default(false) | bool %}
{% if vector_caddy_metrics_enabled | default(vector_proxy_engine_effective | default('caddy') == 'caddy') | bool %}
{% set _ = remote_inputs.append("xhttp_caddy_labels") %}
{% endif %}
{% set _ = remote_inputs.append("xhttp_event_metrics") %}
{% endif %}
{% for source_name in ai_aggregator_remote_inputs %}
  {% set _ = remote_inputs.append(source_name) %}
{% endfor %}
{% if xray_exporter_enabled %}
  {% set _ = remote_inputs.append("add_xray_xhttp_labels") %}
{% if not (xray_merged_mode | default(false) | bool) %}
  {% set _ = remote_inputs.append("add_xray_tcp_labels") %}
{% endif %}
{% endif %}
{% if postgres_exporter_enabled %}
  {% set _ = remote_inputs.append("add_postgres_labels") %}
{% endif %}
{% for target in ssl_targets %}
  {% set _ = remote_inputs.append("blackbox_" ~ (target.name | regex_replace('[^A-Za-z0-9_]', '_')) ~ "_labels") %}
{% endfor %}
inputs = {{ remote_inputs | to_json }}
{% if vector_local_observability_enabled | default(false) | bool or inventory_hostname == 'install.svc.plus' %}
endpoint = "http://127.0.0.1:9090/api/v1/write"
{% else %}
endpoint = "{{ vector_observability_endpoint | default('https://observability.svc.plus') }}/ingest/metrics/api/v1/write"
{# 鉴权来源按 vector_auth_mode 三选一, 由 tasks 渲染前解析并断言。
   vault:       Vault Agent 渲染的运行时文件(优先, 支持轮换)
   static:      控制面经环境变量注入的凭据
   static-file: pull 模式下从持久凭据文件读取 —— 用环境变量间接传值,
                避免把明文凭据写进 vector.toml #}
{% if vector_auth_mode | default('none') == 'vault' %}
[secret.agent_proxy_vault]
type = "exec"
command = ["/usr/local/libexec/agent-proxy-vector-secret-provider", {{ vector_auth_external_file | to_json }}]
[sinks.prometheus_remote.auth]
strategy = "basic"
user = "SECRET[agent_proxy_vault.user]"
password = "SECRET[agent_proxy_vault.password]"
{% elif vector_auth_mode | default('none') == 'static' %}
[sinks.prometheus_remote.auth]
strategy = "basic"
user = "{{ vector_auth_user }}"
password = "{{ vector_auth_password }}"
{% elif vector_auth_mode | default('none') == 'static-file' %}
[sinks.prometheus_remote.auth]
strategy = "basic"
user = "${VECTOR_AUTH_USER}"
password = "${VECTOR_AUTH_PASSWORD}"
{% endif %}
{% endif %}
[sinks.prometheus_remote.tls]
verify_certificate = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}
verify_hostname = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}
[sinks.prometheus_remote.healthcheck]
enabled = false
[sinks.prometheus_remote.batch]
max_events = {{ vector_batch_max_events | default('500') }}
timeout_secs = {{ vector_batch_timeout | default('5') }}
[sinks.prometheus_remote.request]
retry_initial_backoff_secs = 2
retry_max_duration_secs = 3600
rate_limit_duration_secs = 1
rate_limit_num = 10
[sinks.prometheus_remote.buffer]
type = "memory"
max_events = {{ vector_buffer_max_events | default('1000') }}


# ==========================================
# 2. Logs Collection (VictoriaLogs)
# ==========================================
[sources.system_logs]
type = "file"
{% if inventory_hostname == 'install.svc.plus' %}
include = ["/var/log/**/*.log", "/var/log/syslog", "/var/log/auth.log"]
{% elif inventory_hostname == 'tky-proxy.svc.plus' %}
include = ["/var/log/xray/error.log"]
{% else %}
include = ["/var/log/syslog", "/var/log/auth.log"]
{% endif %}
ignore_older_secs = 86400

{% if vector_system_journald_enabled | default(false) | bool and not (vector_xhttp_monitoring_enabled | default(false) | bool) %}
[sources.system_journal]
type = "journald"
current_boot_only = true
include_units = {{ vector_system_journald_units | to_json }}
exclude_units = ["vector.service"]
{% endif %}

[transforms.process_logs]
type = "remap"
drop_on_abort = true
{% if vector_xhttp_monitoring_enabled | default(false) | bool %}
inputs = ["system_logs", "xhttp_journal"]
{% elif vector_system_journald_enabled | default(false) | bool %}
inputs = ["system_logs", "system_journal"]
{% else %}
inputs = ["system_logs"]
{% endif %}
source = '''
if is_string(.message) {
  if contains(string!(.message), "{{ xconnect_vector_policy.get('reverse_proxy_drop_substring', 'http.handlers.reverse_proxy') }}") { abort }
  .message = truncate(string!(.message), {{ xconnect_vector_policy.get('log_message_max_bytes', 4096) | int }})
}
.instance = "{{ vector_observability_node_identity }}"
.node = "{{ vector_observability_node_identity }}"
.host = "{{ inventory_hostname }}"
.environment = "{{ vector_observability_environment }}"
.env = "{{ vector_observability_environment }}"
.provider = "{{ vector_observability_provider }}"
.region = {{ obs_region | to_json }}
.resource_id = {{ obs_resource_id | to_json }}
.runtime_form = {{ obs_runtime_form | to_json }}
.resource_key = {{ obs_resource_key | to_json }}
.service = "{{ vector_observability_node_identity }}"
.job = "system_logs"
.service_domain = "{{ vector_observability_node_identity }}"
.source_type = "system_logs"
'''

# Docker containers are the primary runtime for the platform services. Keep
# their stdout/stderr as structured events so Victoria Logs can filter the
# core applications by container, host and stream.
{% if obs_docker_logs_enabled %}
[sources.docker_logs]
type = "docker_logs"
auto_partial_merge = true
docker_host = "unix:///var/run/docker.sock"

[transforms.process_docker_logs]
type = "remap"
inputs = ["docker_logs"]
source = '''
.host = "{{ inventory_hostname }}"
.source_type = "docker_logs"
.instance = "{{ vector_observability_node_identity }}"
.node = "{{ vector_observability_node_identity }}"
.environment = "{{ vector_observability_environment }}"
.env = "{{ vector_observability_environment }}"
.provider = "{{ vector_observability_provider }}"
.region = {{ obs_region | to_json }}
.resource_id = {{ obs_resource_id | to_json }}
.runtime_form = {{ obs_runtime_form | to_json }}
.resource_key = {{ obs_resource_key | to_json }}
.service_domain = "{{ vector_observability_node_identity }}"

# Application services emit JSON slog/Node records. Promote the structured
# fields so VictoriaLogs and Grafana can correlate logs with OTel spans.
if is_string(.message) {
  parsed, err = parse_json(.message)
  if err == null && is_object(parsed) {
    . = merge!(., parsed)
  }
}
if !exists(.service_name) && exists(.container_name) {
  .service_name = .container_name
}
if exists(.service_name) {
  . = set!(., ["service.name"], .service_name)
  if !exists(.service) {
    .service = .service_name
  }
  if !exists(.job) {
    .job = .service_name
  }
}
if !exists(.environment) {
  .environment = "unknown"
}
'''
{% endif %}

[sinks.victorialogs]
type = "http"
inputs = ["process_logs"{% if obs_docker_logs_enabled %}, "process_docker_logs"{% endif %}]
{% if vector_local_observability_enabled | default(false) | bool or inventory_hostname == 'install.svc.plus' %}
uri = "http://127.0.0.1:9428/insert/jsonline?_msg_field=message&_stream_fields=instance,file"
{% else %}
uri = "{{ vector_observability_endpoint | default('https://observability.svc.plus') }}/ingest/logs/insert/jsonline?_msg_field=message&_stream_fields=instance,file"
{% endif %}
encoding.codec = "json"
framing.method = "newline_delimited"
[sinks.victorialogs.batch]
max_bytes = {{ xconnect_vector_policy.get('sink_batch_max_bytes', 1048576) | int }}
timeout_secs = {{ xconnect_vector_policy.get('sink_batch_timeout_secs', 5) | int }}
[sinks.victorialogs.request]
retry_initial_backoff_secs = 2
retry_max_duration_secs = 3600
rate_limit_duration_secs = 1
rate_limit_num = 10
[sinks.victorialogs.buffer]
type = "memory"
max_events = {{ xconnect_vector_policy.get('sink_buffer_max_events', 500) | int }}
{% if not (vector_local_observability_enabled | default(false) | bool or inventory_hostname == 'install.svc.plus') %}
{% if vector_auth_mode | default('none') == 'vault' %}
# 复用上面已声明的 [secret.agent_proxy_vault], 不重复定义同类 secret。
[sinks.victorialogs.auth]
strategy = "basic"
user = "SECRET[agent_proxy_vault.user]"
password = "SECRET[agent_proxy_vault.password]"
{% elif vector_auth_mode | default('none') == 'static' %}
[sinks.victorialogs.auth]
strategy = "basic"
user = "{{ vector_auth_user }}"
password = "{{ vector_auth_password }}"
{% elif vector_auth_mode | default('none') == 'static-file' %}
[sinks.victorialogs.auth]
strategy = "basic"
user = "${VECTOR_AUTH_USER}"
password = "${VECTOR_AUTH_PASSWORD}"
{% endif %}
{% endif %}
[sinks.victorialogs.tls]
verify_certificate = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}
verify_hostname = {{ 'true' if xconnect_vector_policy.get('tls_verify', vector_tls_verify | default(true)) | bool else 'false' }}

[sinks.victorialogs.healthcheck]
enabled = false

# ==========================================
# 3. Traces Collection (VictoriaTraces)
# ==========================================
# Note: The 'opentelemetry' sink is unsupported in the currently installed Vector version.
# For tracing, applications should directly push OTLP data to the gateway:
# https://observability.svc.plus/ingest/otlp/v1/traces
