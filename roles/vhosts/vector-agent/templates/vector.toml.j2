# Vector Configuration optimized for low resource footprint
{% set xconnect_vector_policy = ((xconnect_node_maintenance | default({})).get('vector', {})) %}
{% set obs_k3s_node = (vector_k3s_node_effective | default(false) | bool) or ('k3s' in (group_names | default([]))) or ('k3s_server' in (group_names | default([]))) or ('k3s_agent' in (group_names | default([]))) or ((runtime_form | default(cmdb_runtime_form | default(''))) == 'k3s') %}
{% set obs_docker_logs_enabled = (vector_docker_logs_enabled | bool) if (vector_docker_logs_enabled is defined) else ((false if obs_k3s_node else (vector_docker_logs_enabled_effective | default(true) | bool))) %}
{% set obs_runtime_form = vector_observability_runtime_form | default(runtime_form | default(cmdb_runtime_form | default('k3s' if obs_k3s_node else ('docker' if obs_docker_logs_enabled else 'systemd'), true), true), true) %}
{% set obs_region = vector_observability_region | default(region | default(cmdb_region | default(cloud_region | default(provider_region | default(logical_region | default('unknown', true), true), true), true), true), true) %}
{% set obs_host = vector_observability_host | default(inventory_hostname, true) %}
{% set obs_resource_id = vector_observability_resource_id | default(resource_id | default(cmdb_resource_id | default(instance_id | default(cmdb_instance_id | default(inventory_hostname, true), true), true), true), true) %}
{% set obs_account_or_project = vector_observability_project_id | default(project_id | default(cmdb_project_id | default(account | default('unknown', true), true), true), true) %}
{% set obs_resource_key = vector_observability_resource_key | default(resource_key | default(cmdb_resource_key | default(vector_observability_provider ~ ':' ~ obs_account_or_project ~ ':' ~ obs_region ~ ':' ~ obs_resource_id, true), true), true) %}
{% set obs_node_metrics_enabled = (vector_node_metrics_enabled | default(not (obs_k3s_node and (vector_k3s_cluster_scrapes_node_exporter | default(false) | bool))) | bool) %}
{% set obs_process_metrics_enabled = (vector_process_metrics_enabled | default(true) | bool) %}
{% if vector_billing_ingest_enabled | default(false) | bool %}
[secret.local_secret]
type = "exec"
command = ["/usr/local/libexec/vector-secret-provider"]
{% endif %}
[api]
enabled = false # Disable API to save memory

