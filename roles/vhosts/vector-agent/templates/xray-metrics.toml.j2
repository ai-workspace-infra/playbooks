{% set xray_obs_region = vector_observability_region | default(region | default(cmdb_region | default(cloud_region | default(provider_region | default(logical_region | default('unknown', true), true), true), true), true), true) %}
{% set xray_obs_resource_id = vector_observability_resource_id | default(resource_id | default(cmdb_resource_id | default(instance_id | default(cmdb_instance_id | default(inventory_hostname, true), true), true), true), true) %}
{% set xray_obs_runtime_form = vector_observability_runtime_form | default(runtime_form | default(cmdb_runtime_form | default('systemd', true), true), true) %}
{% set xray_obs_account = vector_observability_project_id | default(project_id | default(cmdb_project_id | default(account | default('unknown', true), true), true), true) %}
{% set xray_obs_resource_key = vector_observability_resource_key | default(resource_key | default(cmdb_resource_key | default(vector_observability_provider ~ ':' ~ xray_obs_account ~ ':' ~ xray_obs_region ~ ':' ~ xray_obs_resource_id, true), true), true) %}
[sources.xray_xhttp_metrics]
type = "prometheus_scrape"
endpoints = ["http://127.0.0.1:8080/scrape"]
scrape_interval_secs = {{ vector_scrape_interval | default('15') | replace('s', '') | int }}

[sources.xray_tcp_metrics]
type = "prometheus_scrape"
endpoints = ["http://127.0.0.1:8081/scrape"]
scrape_interval_secs = {{ vector_scrape_interval | default('15') | replace('s', '') | int }}

[transforms.add_xray_xhttp_labels]
type = "remap"
inputs = ["xray_xhttp_metrics"]
source = '''
.tags.instance = "{{ inventory_hostname }}"
.tags.host = "{{ inventory_hostname }}"
.tags.environment = "{{ vector_observability_environment }}"
.tags.env = "{{ vector_observability_environment }}"
.tags.provider = "{{ vector_observability_provider }}"
.tags.region = {{ xray_obs_region | to_json }}
.tags.resource_id = {{ xray_obs_resource_id | to_json }}
.tags.runtime_form = {{ xray_obs_runtime_form | to_json }}
.tags.resource_key = {{ xray_obs_resource_key | to_json }}
.tags.service_domain = "{{ vector_observability_service_domain }}"
.tags.job = "xray"
.tags.service = "xray"
.tags.transport = "xhttp"
'''

[transforms.add_xray_tcp_labels]
type = "remap"
inputs = ["xray_tcp_metrics"]
source = '''
.tags.instance = "{{ inventory_hostname }}"
.tags.host = "{{ inventory_hostname }}"
.tags.environment = "{{ vector_observability_environment }}"
.tags.env = "{{ vector_observability_environment }}"
.tags.provider = "{{ vector_observability_provider }}"
.tags.region = {{ xray_obs_region | to_json }}
.tags.resource_id = {{ xray_obs_resource_id | to_json }}
.tags.runtime_form = {{ xray_obs_runtime_form | to_json }}
.tags.resource_key = {{ xray_obs_resource_key | to_json }}
.tags.service_domain = "{{ vector_observability_service_domain }}"
.tags.job = "xray"
.tags.service = "xray"
.tags.transport = "tcp"
'''
