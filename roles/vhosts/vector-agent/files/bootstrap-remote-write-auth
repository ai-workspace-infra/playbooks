#!/bin/bash
# Bootstrap the persistent Vector remote-write credential used by pull mode.
#
# Why this exists: the control plane injects VECTOR_AUTH_USER/PASSWORD as
# environment variables. ansible-pull has no such environment, so without a
# persisted credential the pull run would render sinks without authentication
# (or, with the role's fail-closed assertion, refuse to converge at all).
#
# Order of preference — this script NEVER invents or rotates a secret:
#   1. /etc/vector/remote-write-auth.json already present  -> nothing to do
#   2. /etc/vector/secrets.json (exec-backed provider)      -> not a basic-auth pair, skip
#   3. the live /etc/vector/vector.toml [sinks.*.auth] block -> copy forward
#
# The value found in the live config was itself delivered by the control plane,
# so copying it forward preserves the existing trust chain instead of creating a
# second credential source. Output is a 0600 root-only file in the exact
# EnvironmentFile format systemd consumes.
#
# Exit codes: 0 = credential available, 3 = nothing to migrate (caller decides).

set -euo pipefail

TARGET="${VECTOR_AUTH_STATIC_FILE:-/etc/vector/remote-write-auth.json}"
CONFIG="${VECTOR_CONFIG_PATH:-/etc/vector/vector.toml}"
OWNER="${VECTOR_AUTH_FILE_OWNER:-root:root}"

if [[ -s "$TARGET" ]]; then
  exit 0
fi

if [[ ! -r "$CONFIG" ]]; then
  echo "bootstrap-remote-write-auth: cannot read $CONFIG" >&2
  exit 3
fi

# Pull the first basic-auth user/password pair out of the sink configuration.
# Only the two literal scalar forms the role itself emits are accepted; a
# SECRET[...] reference means the credential lives in the exec provider, which
# pull mode does not use.
user=""
password=""
while IFS= read -r line; do
  key="${line%%=*}"
  val="${line#*=}"
  key="$(printf '%s' "$key" | tr -d '[:space:]')"
  val="$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')"
  case "$key" in
    user)     [[ -z "$user"     ]] && user="$val" ;;
    password) [[ -z "$password" ]] && password="$val" ;;
  esac
  [[ -n "$user" && -n "$password" ]] && break
done < <(awk '
  /^\[sinks\.[^]]+\.auth\]/ { in_auth = 1; next }
  /^\[/                        { in_auth = 0 }
  in_auth && /^(user|password)[[:space:]]*=/ { print }
' "$CONFIG")

if [[ -z "$user" || -z "$password" ]]; then
  echo "bootstrap-remote-write-auth: no static basic-auth pair in $CONFIG" >&2
  exit 3
fi

case "$user$password" in
  *SECRET\[*)
    echo "bootstrap-remote-write-auth: credential is exec-backed; not migrating" >&2
    exit 3
    ;;
esac

install -d -m 0700 "$(dirname "$TARGET")"
umask 077
tmp="$(mktemp "$TARGET.XXXXXX")"
{
  echo "# Generated by bootstrap-remote-write-auth from the control-plane delivered"
  echo "# sink credentials. Do not edit; rotate at the source and re-run the pull."
  printf 'VECTOR_AUTH_USER=%s\n' "$user"
  printf 'VECTOR_AUTH_PASSWORD=%s\n' "$password"
} > "$tmp"
chmod 0600 "$tmp"
chown "$OWNER" "$tmp"
mv -f "$tmp" "$TARGET"

echo "bootstrap-remote-write-auth: persisted remote-write credential to $TARGET"
