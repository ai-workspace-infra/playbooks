#!/usr/bin/env python3
"""Serve Vector's v1 secret-provider requests from the root-only JSON file."""

import json
import sys

SECRET_FILE = "/etc/vector/secrets.json"

request = {}
try:
    request = json.load(sys.stdin)
    with open(SECRET_FILE, encoding="utf-8") as stream:
        available = json.load(stream)
    response = {}
    for name in request.get("secrets", []):
        value = available.get(name)
        if isinstance(value, str) and value:
            response[name] = {"value": value, "error": None}
        else:
            response[name] = {"value": None, "error": "secret is missing or empty"}
    print(json.dumps(response))
except Exception as exc:
    print(json.dumps({name: {"value": None, "error": str(exc)}
                      for name in request.get("secrets", [])}), flush=True)
    sys.exit(1)
