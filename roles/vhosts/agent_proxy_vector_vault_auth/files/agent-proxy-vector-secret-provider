#!/usr/bin/env python3
"""Read Vector v1 exec-backend requests from a protected JSON file."""
import json
import sys

try:
    request = json.load(sys.stdin)
    with open(sys.argv[1], encoding="utf-8") as stream:
        credentials = json.load(stream)
    response = {}
    for name in request.get("secrets", []):
        value = credentials.get(name) if name in ("user", "password") else None
        response[name] = {"value": value if isinstance(value, str) and value else None,
                          "error": None if isinstance(value, str) and value else "secret unavailable"}
    print(json.dumps(response))
except (OSError, ValueError, IndexError, TypeError):
    print("secret provider unavailable", file=sys.stderr)
    raise SystemExit(1)
