#!/usr/bin/env python3
"""Validate Vault-rendered Vector sink auth, atomically install changes, restart safely."""
import json
import os
import grp
import subprocess
import sys
import tempfile
from pathlib import Path

SOURCE = Path(os.environ.get("AGENT_PROXY_VECTOR_VAULT_RENDERED", "/var/lib/vault-agent/agent-proxy-vector-auth/credentials.json"))
DEST = Path(os.environ.get("AGENT_PROXY_VECTOR_AUTH_FILE", "/run/vector/remote-write-auth.json"))
VECTOR_CONFIG = Path(os.environ.get("VECTOR_CONFIG", "/etc/vector/vector.toml"))


def fail(message: str) -> int:
    print(f"agent-proxy-vector-auth: {message}", file=sys.stderr)
    return 1


def is_vector_active() -> bool:
    result = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=ActiveState", "--value", "vector.service"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == b"active"


def validate_and_start() -> bool:
    checked = subprocess.run(
        ["/usr/bin/vector", "validate", "--no-environment", "--config-toml", str(VECTOR_CONFIG)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if checked.returncode:
        return False
    return subprocess.run(["/usr/bin/systemctl", "start", "vector.service"], check=False).returncode == 0


def main() -> int:
    try:
        raw = SOURCE.read_text(encoding="utf-8")
        entries = json.loads(raw)
        if not isinstance(entries, dict) or not {"user", "password"}.issubset(entries):
            return fail("Vault rendered credential fields are missing or empty")
        if not all(isinstance(entries[key], str) and entries[key] for key in ("user", "password")):
            return fail("Vault rendered credential fields are missing or empty")
        current = DEST.read_text(encoding="utf-8") if DEST.exists() else ""
        desired = json.dumps(
            {key: entries[key] for key in ("user", "password")},
            ensure_ascii=False,
            separators=(",", ":"),
        ) + "\n"
        if current == desired:
            if not VECTOR_CONFIG.is_file() or is_vector_active():
                return 0
            if not validate_and_start():
                return fail("Vector is inactive and could not be validated and started")
            return 0
        DEST.parent.mkdir(parents=True, mode=0o750, exist_ok=True)
        fd, temp_name = tempfile.mkstemp(prefix=".remote-write-auth.", dir=DEST.parent)
        backup = None
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(desired)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temp_name, 0o640)
            os.chown(temp_name, 0, grp.getgrnam(os.environ.get("VECTOR_GROUP", "vector")).gr_gid)
            if DEST.exists():
                backup = DEST.read_bytes()
            os.replace(temp_name, DEST)
            if not VECTOR_CONFIG.is_file():
                return 0
            was_active = is_vector_active()
            if not was_active:
                return 0
            checked = subprocess.run(
                ["/usr/bin/vector", "validate", "--no-environment", "--config-toml", str(VECTOR_CONFIG)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if checked.returncode:
                if backup is None:
                    DEST.unlink(missing_ok=True)
                else:
                    DEST.write_bytes(backup)
                    os.chmod(DEST, 0o640)
                return fail("Vector rejected updated credential file; previous credentials restored")
            restarted = subprocess.run(["/usr/bin/systemctl", "restart", "vector.service"], check=False)
            if restarted.returncode:
                if backup is None:
                    DEST.unlink(missing_ok=True)
                else:
                    DEST.write_bytes(backup)
                    os.chmod(DEST, 0o640)
                subprocess.run(["/usr/bin/systemctl", "restart", "vector.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                return fail("Vector restart failed; previous credentials restored")
            return 0
        finally:
            try:
                os.unlink(temp_name)
            except FileNotFoundError:
                pass
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        return fail(f"credential sync failed ({type(exc).__name__})")


if __name__ == "__main__":
    raise SystemExit(main())
