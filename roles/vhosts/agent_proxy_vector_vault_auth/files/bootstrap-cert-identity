#!/usr/bin/env python3
"""Provision one node certificate and register it using a bootstrap Vault token."""
import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path


def need(name):
    value = os.environ.get(name, "")
    if not value:
        raise ValueError("missing " + name)
    return value


def main():
    address = need("VAULT_ADDR").rstrip("/")
    token = need("VAULT_TOKEN")
    mount = need("CERT_AUTH_MOUNT")
    role = need("CERT_AUTH_ROLE")
    prefix = need("CERT_FIELD_PREFIX")
    policy = need("CERT_AUTH_POLICY")
    path = need("CERT_KV_DATA_PATH")
    if not address.startswith("https://") or not re.fullmatch(r"[a-z0-9_-]+", mount) or not re.fullmatch(r"[a-z0-9_-]+", role) or not re.fullmatch(r"[a-z0-9_]+", prefix) or not path.startswith("kv/data/") or ".." in path.split("/"):
        raise ValueError("invalid identity configuration")
    cert, key = Path(need("CLIENT_CERT_FILE")), Path(need("CLIENT_KEY_FILE"))
    changed = False
    cert.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if cert.exists() != key.exists():
        raise ValueError("incomplete existing certificate identity")
    if not cert.exists():
        subprocess.run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256", "-nodes", "-keyout", str(key), "-out", str(cert), "-days", "365", "-subj", "/CN=" + role, "-addext", "extendedKeyUsage=clientAuth", "-addext", "basicConstraints=critical,CA:FALSE"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, umask=0o077)
        changed = True
    os.chmod(cert, 0o600)
    os.chmod(key, 0o600)
    public_cert = subprocess.check_output(["openssl", "x509", "-in", str(cert), "-pubkey", "-noout"], stderr=subprocess.DEVNULL)
    public_key = subprocess.check_output(["openssl", "pkey", "-in", str(key), "-pubout"], stderr=subprocess.DEVNULL)
    if public_cert != public_key:
        raise ValueError("certificate and key do not match")
    def request(method, endpoint, payload=None, patch=False):
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"X-Vault-Token": token, "Content-Type": "application/merge-patch+json" if patch else "application/json"}
        req = urllib.request.Request(address + "/v1/" + endpoint, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=15) as response:
                body = response.read()
                return json.loads(body) if body else {}
        except urllib.error.HTTPError as exc:
            if method == "GET" and exc.code == 404:
                return None
            raise
    role_path = "auth/" + mount + "/certs/" + role
    current = request("GET", role_path)
    pem = cert.read_text()
    if current:
        data = current["data"]
        if data["certificate"].strip() != pem.strip() or data["token_policies"] != [policy] or not data["token_no_default_policy"]:
            raise ValueError("existing certificate role differs")
    record = request("GET", path)
    fields = {prefix + "_client_cert_pem_b64": base64.b64encode(cert.read_bytes()).decode(), prefix + "_client_key_pem_b64": base64.b64encode(key.read_bytes()).decode()}
    old = record["data"]["data"] if record else {}
    if any(name in old and old[name] != value for name, value in fields.items()):
        raise ValueError("existing certificate KV fields differ")
    if not record:
        request("POST", path, {"options": {"cas": 0}, "data": fields})
        changed = True
    elif any(name not in old for name in fields):
        request("PATCH", path, {"options": {"cas": record["data"]["metadata"]["version"]}, "data": fields}, patch=True)
        changed = True
    if not current:
        request("POST", role_path, {"certificate": pem, "token_policies": [policy], "token_no_default_policy": True, "token_ttl": "1h", "token_max_ttl": "24h"})
        changed = True
    print("changed" if changed else "unchanged")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError, urllib.error.URLError) as exc:
        print("certificate registration failed (" + type(exc).__name__ + ")", file=sys.stderr)
        sys.exit(1)
