[Unit]
Description={{ xray_exporter_instance.description }}
After=network.target

[Service]
Type=simple
User={{ xray_exporter_user }}
Group={{ xray_exporter_group }}
EnvironmentFile=-{{ xray_exporter_env_file }}
ExecStart={{ xray_exporter_binary_path }} -l {{ xray_exporter_instance.listen_addr }} -e {{ xray_exporter_instance.xray_api_addr }}{% if xray_exporter_user_traffic_metrics | bool %} -u{% endif %}{% if xray_exporter_log_path | trim | length > 0 %} -p {{ xray_exporter_log_path }}{% endif %} --node-id {{ xray_exporter_instance.node_id }} --snapshot-store-path {{ xray_exporter_instance.snapshot_store_path }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
