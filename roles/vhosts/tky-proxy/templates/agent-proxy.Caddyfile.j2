{
	# Keep production at the normal INFO level. The default logger omits
	# reverse-proxy chatter (including expected client cancellations); retain
	# only ERROR records from that module in its own logger.
	log default {
		exclude http.handlers.reverse_proxy
	}
	log reverseproxy_errors {
		level ERROR
		include http.handlers.reverse_proxy
	}
}

# Agent Proxy virtual hosts are managed exclusively in conf.d. The same
# environment-aware fragment is used for UAT and PROD; the playbook removes
# the PROD-only compatibility fragment when the current node is not PROD.
import {{ agent_proxy_caddy_conf_dir }}/*.caddy
