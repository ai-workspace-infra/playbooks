{{ tky_proxy_domains | join(' ') }} {

    tls {{ agent_tls_cert_path }} {{ agent_tls_key_path }}

    @xhttp {
        path /split/*
    }

    handle @xhttp {
        reverse_proxy unix//dev/shm/xray.sock {
            transport http {
                versions h2c 2
            }
        }
    }

    respond "Agent Service Plus Node"
}
