{{ tky_proxy_domains | join(' ') }} {

    tls {{ agent_tls_cert_path }} {{ agent_tls_key_path }}

    # Billing 从 web-saas 节点通过 HTTPS 拉取 Exporter window snapshots。
    # handle_path 去掉外部前缀后再转给本机两个 exporter 实例；8080/8081
    # 不需要对公网开放，Bearer token 继续由 Billing 透传给 exporter。
    handle_path /xray-exporter/xhttp/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle_path /xray-exporter/tcp/* {
        reverse_proxy 127.0.0.1:8081
    }

    @xhttp {
        # Xray XHTTP uses the configured path itself for the initial request
        # and may use descendants for subsequent stream requests. Keep the
        # original path when proxying: handle_path would strip `/split`.
        path /split /split/*
    }

    @xhttp_root path /split
    # Xray normalizes its configured path to `/split/`. Rewrite the exact
    # legacy client path internally so existing subscriptions keep working.
    rewrite @xhttp_root /split/

    handle @xhttp {
        # `x_padding` is not part of this node's XHTTP contract. Some clients
        # serialize an unset value as `x_padding=`, which Xray rejects before
        # the VLESS handshake. Remove it in the selected XHTTP handler so the
        # mutation is guaranteed to run immediately before proxying.
        uri query -x_padding

        reverse_proxy unix//dev/shm/xray.sock {
            transport http {
                versions h2c 2
            }
        }
    }

    respond "Agent Service Plus Node"
}
