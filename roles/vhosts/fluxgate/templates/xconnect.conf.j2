{% set _fg_nm = (xconnect_node_maintenance | default({})).get('fluxgate', {}) %}
{{ (fluxgate_resolved_vhosts | default(fluxgate_vhosts)) | join(' ') }} {
    tls {{ fluxgate_tls_dir }}/agent-proxy.crt {{ fluxgate_tls_dir }}/agent-proxy.key

    handle_path /xray-exporter/xhttp/* {
        reverse_proxy {{ fluxgate_exporter_xhttp_upstream }}
    }

    handle_path /xray-exporter/tcp/* {
        reverse_proxy {{ fluxgate_exporter_xhttp_upstream if (xray_merged_mode | default(false) | bool) else fluxgate_exporter_tcp_upstream }}
    }

    @xhttp {
        path /split /split/*
    }

    @xhttp_root path /split
    rewrite @xhttp_root /split/

    handle @xhttp {
{% if fluxgate_strip_x_padding | default(true) | bool %}
        uri query -x_padding
{% endif %}

        reverse_proxy unix//{{ fluxgate_xhttp_unix_socket | regex_replace('^/', '') }} {
            flush_interval -1

            transport http {
                versions h2c 2
                h2_stream_window_size {{ _fg_nm.get('h2_stream_window_size', fluxgate_h2_stream_window_size | default(4194304)) }}
                h2_connection_window_size {{ _fg_nm.get('h2_connection_window_size', fluxgate_h2_connection_window_size | default(16777216)) }}
                h2_ping_interval_secs {{ _fg_nm.get('h2_ping_interval_secs', fluxgate_h2_ping_interval_secs | default(15)) }}
                max_h2_streams {{ _fg_nm.get('max_h2_streams', fluxgate_max_h2_streams | default(256)) }}
                read_timeout_secs {{ _fg_nm.get('read_timeout_secs', fluxgate_read_timeout_secs | default(3600)) }}
                idle_timeout_secs {{ _fg_nm.get('idle_timeout_secs', fluxgate_idle_timeout_secs | default(3600)) }}
            }
        }
    }

{% if fluxgate_gateway_enabled | default(xconnect_gateway_caddy_enabled | default(false)) | bool %}
{% set gw_path = (fluxgate_gateway_path | default(xconnect_gateway_caddy_path | default('/xconnect', true), true)) | regex_replace('/+$', '') %}
    @xconnect_gateway_xhttp {
        path {{ gw_path }} {{ gw_path }}/*
    }

    @xconnect_gateway_root path {{ gw_path }}
    rewrite @xconnect_gateway_root {{ gw_path }}/

    handle @xconnect_gateway_xhttp {
{% if fluxgate_strip_x_padding | default(true) | bool %}
        uri query -x_padding
{% endif %}

        reverse_proxy unix//{{ (fluxgate_gateway_unix_socket | default(xconnect_gateway_listen_socket | default('/run/xconnect-gateway/xray.sock', true), true)) | regex_replace('^/', '') }} {
            flush_interval -1

            transport http {
                versions h2c 2
                h2_stream_window_size {{ _fg_nm.get('h2_stream_window_size', fluxgate_h2_stream_window_size | default(4194304)) }}
                h2_connection_window_size {{ _fg_nm.get('h2_connection_window_size', fluxgate_h2_connection_window_size | default(16777216)) }}
                h2_ping_interval_secs {{ _fg_nm.get('h2_ping_interval_secs', fluxgate_h2_ping_interval_secs | default(15)) }}
                max_h2_streams {{ _fg_nm.get('max_h2_streams', fluxgate_max_h2_streams | default(256)) }}
                read_timeout_secs {{ _fg_nm.get('read_timeout_secs', fluxgate_read_timeout_secs | default(3600)) }}
                idle_timeout_secs {{ _fg_nm.get('idle_timeout_secs', fluxgate_idle_timeout_secs | default(3600)) }}
            }
        }
    }
{% endif %}

    respond "{{ fluxgate_default_response }}"
}
