{
  "schema_version": 1,
  "id": "xconnect-one",
  "version": {{ xconnect_gateway_provider_version | to_json }},
  "mode": {{ ('apply' if xconnect_gateway_runtime_apply_enabled | bool else 'shadow') | to_json }},
  "snapshot_schema": {
    "minimum": {{ xconnect_gateway_snapshot_schema_min | int }},
    "maximum": {{ xconnect_gateway_snapshot_schema_max | int }}
  },
  "runtime": {
    "proxy_core": "xray",
    "proxy_core_version": {{ xconnect_gateway_xray_required_version | to_json }}
  },
  "capabilities": [
    "peer.validate",
    "peer.render",
    "peer.read-back",
    "policy.validate",
    "policy.render",
    "relay.validate",
    "relay.render",
    "diagnostics.collect"{% if xconnect_gateway_runtime_apply_enabled | bool %},
    "peer.apply",
    "policy.apply",
    "relay.apply",
    "transaction.rollback"
{% endif %}
  ],
  "backends": {
    "peer": "wireguard",
    "policy": "nftables",
    "relay": "xray"
  },
  "permissions": {
    "apply_runtime": {{ xconnect_gateway_runtime_apply_enabled | bool | to_json }},
    "linux_capabilities": {{ (['CAP_NET_ADMIN'] if xconnect_gateway_runtime_apply_enabled | bool else []) | to_json }}
  },
  "rollback": {
    "level": "last-known-good",
    "directory": {{ xconnect_gateway_last_known_good_dir | to_json }}
  }
}
