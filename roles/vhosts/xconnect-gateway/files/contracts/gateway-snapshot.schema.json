{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.xconnect.one/gateway-snapshot-v1.json",
  "title": "XConnect-One GatewaySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network_id",
    "node_id",
    "generation",
    "issued_at",
    "expires_at",
    "proxy_core",
    "peers",
    "policies",
    "relay",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "network_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "proxy_core": {"const": "xray"},
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "public_key", "address", "allowed_ips"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "address": {"type": "string", "minLength": 1},
          "allowed_ips": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "policies": {"type": "array", "items": {"type": "object"}},
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "transport", "security"],
      "properties": {
        "backend": {"const": "xray"},
        "transport": {"const": "vless"},
        "security": {"const": "tls"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}

