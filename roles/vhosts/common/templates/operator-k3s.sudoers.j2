# {{ ansible_managed }}
# vhosts/common operator_k3s_sudo: passwordless sudo for {{ common_operator_k3s_sudo_user }}
# on an explicit list of K3s/GitOps client binaries only (no ALL, no wildcards).
Cmnd_Alias OPERATOR_K3S_CMDS = {{ common_operator_k3s_sudo_commands | join(', ') }}
{{ common_operator_k3s_sudo_user }} ALL=(root) NOPASSWD: OPERATOR_K3S_CMDS
