global
    log /dev/log local0 warning
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    nbthread {{ haproxy_nbthread }}

    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-options prefer-client-ciphers no-sslv3 no-tlsv10 no-tlsv11
    tune.ssl.default-dh-param 2048
    tune.bufsize {{ haproxy_bufsize }}
    tune.h2.initial-window-size {{ haproxy_h2_initial_window_size }}
    tune.pipesize {{ haproxy_pipesize | default(262144) }}

defaults
    log     global
    mode    http
    option  dontlognull
    option  dontlog-normal
    option  clitcpka
    option  srvtcpka
    timeout connect 5s
    timeout client  {{ haproxy_timeout_tunnel }}
    timeout server  {{ haproxy_timeout_tunnel }}
    timeout tunnel  {{ haproxy_timeout_tunnel }}
    timeout http-keep-alive {{ haproxy_timeout_http_keep_alive | default('120s') }}
    timeout http-request 15s

frontend http_in
    bind :::80 v4v6
    http-request redirect scheme https code 308 unless { ssl_fc }

frontend https_in
    bind :::443 v4v6 ssl crt {{ haproxy_pem_path }} alpn h2,http/1.1

{% set gateway_vhosts = (haproxy_resolved_gateway_vhosts | default(haproxy_gateway_vhosts | default([]))) %}
{% set gateway_enabled = (haproxy_gateway_enabled | default(false) | bool) or (gateway_vhosts | length > 0) %}
{% set gw_path = (haproxy_gateway_path | default('/xconnect', true)) | regex_replace('/+$', '') %}
{% if haproxy_use_conf_d_acl | default(false) | bool %}
    acl host_allowed hdr_beg(host) -i -f {{ haproxy_conf_d_dir }}/proxy-hosts.lst
{% if gateway_vhosts | length > 0 %}
    acl host_gw      hdr_beg(host) -i -f {{ haproxy_conf_d_dir }}/gateway-hosts.lst
{% endif %}
{% else %}
    acl host_allowed hdr_beg(host) -i {{ (haproxy_resolved_vhosts | default(haproxy_vhosts)) | join(' ') }}
{% if gateway_vhosts | length > 0 %}
    acl host_gw      hdr_beg(host) -i {{ gateway_vhosts | join(' ') }}
{% endif %}
{% endif %}

    acl is_exp_xhttp path_beg /xray-exporter/xhttp/
    acl is_exp_tcp   path_beg /xray-exporter/tcp/
    acl is_xhttp     path -m reg ^/split(/.*)?$
{% if gateway_enabled %}
    acl is_xconnect  path -m reg ^{{ gw_path }}(/.*)?$
{% endif %}

    use_backend be_exporter_xhttp   if host_allowed is_exp_xhttp{{ ' or host_gw is_exp_xhttp' if gateway_vhosts | length > 0 else '' }}
    use_backend be_exporter_tcp     if host_allowed is_exp_tcp{{ ' or host_gw is_exp_tcp' if gateway_vhosts | length > 0 else '' }}
    use_backend be_xray_xhttp       if host_allowed is_xhttp
{% if gateway_vhosts | length > 0 %}
    use_backend be_xconnect_gateway if host_gw is_xconnect
    use_backend be_gateway_default  if host_gw
{% elif gateway_enabled %}
    use_backend be_xconnect_gateway if host_allowed is_xconnect
{% endif %}
    default_backend be_default

backend be_xray_xhttp
    mode http
    option http-no-delay
    http-request set-path /split/ if { path /split }
{% if haproxy_strip_x_padding | default(true) | bool %}
    http-request set-query "%[query,regsub('(^|&)x_padding=[^&]*','',g),regsub('^&','')]" if { query -m sub x_padding= }
{% endif %}
    server xray {{ haproxy_xhttp_unix_socket }} proto h2{% if haproxy_xhttp_send_proxy_v2 | default(false) | bool %} send-proxy-v2{% endif %}

{% if gateway_enabled %}

backend be_xconnect_gateway
    mode http
    option http-no-delay
    http-request set-path {{ gw_path }}/ if { path {{ gw_path }} }
{% if haproxy_strip_x_padding | default(true) | bool %}
    http-request set-query "%[query,regsub('(^|&)x_padding=[^&]*','',g),regsub('^&','')]" if { query -m sub x_padding= }
{% endif %}
    server xconnect_gw {{ haproxy_gateway_unix_socket }} proto h2
{% endif %}
{% if gateway_vhosts | length > 0 %}

backend be_gateway_default
    mode http
    http-request return status 200 content-type "text/plain; charset=utf-8" string "{{ haproxy_gateway_default_response }}"
{% endif %}

backend be_exporter_xhttp
    mode http
    http-request replace-path /xray-exporter/xhttp/(.*) /\1
    server exp_xhttp {{ haproxy_exporter_xhttp_upstream }}

backend be_exporter_tcp
    mode http
    http-request replace-path /xray-exporter/tcp/(.*) /\1
    server exp_tcp {{ haproxy_exporter_tcp_upstream }}

backend be_default
    mode http
    http-request return status 200 content-type "text/plain; charset=utf-8" string "{{ haproxy_default_response }}"

frontend stats
    mode http
    bind {{ haproxy_stats_listen }}
{% if haproxy_legacy_metrics_listen | default('', true) | length > 0 %}
    bind {{ haproxy_legacy_metrics_listen }}
{% endif %}
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats refresh 10s
