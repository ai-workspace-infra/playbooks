# VictoriaMetrics MCP Server Environment Config
VM_INSTANCE_ENTRYPOINT={{ observability_mcp_victoriametrics_entrypoint }}
VM_INSTANCE_TYPE={{ observability_mcp_victoriametrics_instance_type }}
MCP_SERVER_MODE={{ observability_mcp_victoriametrics_mode | default('http') }}
MCP_LISTEN_ADDR=:{{ observability_mcp_victoriametrics_port }}
PORT={{ observability_mcp_victoriametrics_port }}
{% if observability_mcp_victoriametrics_bearer_token | default('') != '' %}
VM_BEARER_TOKEN={{ observability_mcp_victoriametrics_bearer_token }}
{% endif %}
READ_ONLY=true

