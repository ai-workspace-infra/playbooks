# VictoriaMetrics MCP Server Environment Config
# 变量名以上游 VictoriaMetrics-Community/mcp-victoriametrics 为准。
# 注意:MCP_LISTEN_ADDR 必须绑 0.0.0.0,上游默认 localhost:8080 在容器内会导致
# 端口映射后从宿主机无法连通(健康检查会一直 Connection refused)。
VM_INSTANCE_ENTRYPOINT={{ observability_mcp_victoriametrics_entrypoint }}
VM_INSTANCE_TYPE={{ observability_mcp_victoriametrics_instance_type }}
MCP_SERVER_MODE={{ observability_mcp_victoriametrics_mode }}
MCP_LISTEN_ADDR=0.0.0.0:{{ observability_mcp_victoriametrics_port }}
{% if observability_mcp_victoriametrics_bearer_token | default('') != '' %}
VM_INSTANCE_BEARER_TOKEN={{ observability_mcp_victoriametrics_bearer_token }}
{% endif %}
