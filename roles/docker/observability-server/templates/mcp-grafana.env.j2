# Grafana MCP Server Environment Config
GRAFANA_URL={{ observability_mcp_grafana_url }}
{% if observability_mcp_grafana_service_account_token | default('') != '' %}
GRAFANA_SERVICE_ACCOUNT_TOKEN={{ observability_mcp_grafana_service_account_token }}
{% endif %}
PORT={{ observability_mcp_grafana_port }}
TRANSPORT={{ observability_mcp_grafana_transport }}
{% if observability_mcp_grafana_disable_write | default(true) | bool %}
DISABLE_WRITE=true
{% endif %}
ALLOWED_TOOLS=search,dashboard,datasource,prometheus,loki,alerting,navigation,rendering
