observability.svc.plus {
    # 自动走 Let's Encrypt / ZeroSSL 申请公共证书 (DNS已解析生效)

    # Root redirects to Grafana
    redir / /grafana/

    # ==========================================
    # Auto-fix for subpaths accessed under /grafana/ (e.g. Grafana navigation links)
    # ==========================================
    handle_path /grafana/vmetrics/* {
        reverse_proxy 127.0.0.1:{{ observability_prometheus_port | default('9090') }}
    }
    handle_path /grafana/vlogs/* {
        reverse_proxy 127.0.0.1:9428
    }
    handle_path /grafana/vtraces/* {
        reverse_proxy 127.0.0.1:10428
    }

    # Grafana (可视化大盘面板)
    handle /grafana/* {
        reverse_proxy 127.0.0.1:{{ observability_grafana_port | default('3030') }}
    }
    handle /grafana {
        redir * /grafana/
    }

    # ==========================================
    # VictoriaMetrics / Prometheus (Metrics Ingest & Query)
    # ==========================================
    # [接收] 标准 OTLP/HTTP Metrics 写入 (/v1/metrics, /otlp/v1/metrics, /ingest/otlp/v1/metrics)
    @otlp_metrics path /v1/metrics* /otlp/v1/metrics* /ingest/otlp/v1/metrics* /insert/opentelemetry/v1/metrics*
    handle @otlp_metrics {
        rewrite * /insert/opentelemetry/v1/metrics
        reverse_proxy 127.0.0.1:{{ observability_vmetrics_port | default('9090') }}
    }
    # [接收] Prometheus Remote Write & Import (/api/v1/write, /api/v1/import/*)
    @prom_write path /api/v1/write* /api/v1/import/*
    handle @prom_write {
        reverse_proxy 127.0.0.1:{{ observability_vmetrics_port | default('9090') }}
    }
    # [接收] 兼容原有指标写入路径 (/ingest/metrics/*)
    handle_path /ingest/metrics/* {
        reverse_proxy 127.0.0.1:{{ observability_vmetrics_port | default('9090') }}
    }
    # [查询] 指标数据读取 (Query / UI)
    handle_path /vmetrics/* {
        reverse_proxy 127.0.0.1:{{ observability_prometheus_port | default('9090') }}
    }

    # ==========================================
    # VictoriaLogs / Loki (Logs Ingest & Query)
    # ==========================================
    # [接收] 标准 OTLP/HTTP Logs 写入 (/v1/logs, /otlp/v1/logs, /ingest/otlp/v1/logs)
    @otlp_logs path /v1/logs* /otlp/v1/logs* /ingest/otlp/v1/logs* /insert/opentelemetry/v1/logs*
    handle @otlp_logs {
        rewrite * /insert/opentelemetry/v1/logs
        reverse_proxy 127.0.0.1:9428
    }
    # [接收] VictoriaLogs / JSONLine / Loki 直推 (/insert/jsonline, /insert/loki/*, /insert/elasticsearch/*)
    @vlogs_insert path /insert/jsonline* /insert/loki/* /insert/elasticsearch/* /insert/syslog/*
    handle @vlogs_insert {
        reverse_proxy 127.0.0.1:9428
    }
    # [接收] 兼容原有日志写入路径 (/ingest/logs/*)
    handle_path /ingest/logs/* {
        reverse_proxy 127.0.0.1:9428
    }
    # [查询] 日志数据读取 (Query / UI)
    handle_path /vlogs/* {
        reverse_proxy 127.0.0.1:9428
    }

    # ==========================================
    # OpenTelemetry / VictoriaTraces / Jaeger (Traces Ingest & Query)
    # ==========================================
    # Agent and application telemetry enters through the collector so metrics,
    # logs and traces receive a common resource normalization and trace-derived
    # RED metrics.  Keep the direct trace endpoint below for compatibility.
    handle_path /otlp/* {
        reverse_proxy 127.0.0.1:4319
    }
    handle_path /ingest/otlp/* {
        reverse_proxy 127.0.0.1:4319
    }
    # [接收] 标准 OTLP/HTTP Traces 写入 (/v1/traces, /otlp/v1/traces, /ingest/otlp/v1/traces)
    @otlp_traces path /v1/traces* /otlp/v1/traces* /ingest/otlp/v1/traces* /insert/opentelemetry/v1/traces*
    handle @otlp_traces {
        rewrite * /insert/opentelemetry/v1/traces
        reverse_proxy 127.0.0.1:10428
    }
    # [查询] 链路数据读取 (Trace Query / UI)
    handle_path /vtraces/* {
        reverse_proxy 127.0.0.1:10428
    }


{% if observability_vmalert_enabled | default(false) | bool %}
    # VictoriaMetrics Alerting Engine (告警引擎) —— 仅在回退到独立告警链路时启用
    handle_path /vmalert/* {
        reverse_proxy 127.0.0.1:8880
    }

    # Alertmanager (告警路由分发) —— 仅在回退到独立告警链路时启用
    handle_path /alertmgr/* {
        reverse_proxy 127.0.0.1:9059
    }
{% endif %}

    # Blackbox Exporter (网络与域名拨测)
    handle_path /blackbox/* {
        reverse_proxy 127.0.0.1:9115
    }

    # ==========================================
    # Telemetry Snapshots Export (流式压缩 & 带宽限制)
    # ==========================================
    handle /v1/telemetry/snapshots/export {
        encode gzip zstd
{% if observability_snapshot_rate_limit_enabled | default(false) | bool %}
        rate_limit {
            zone snapshot_export_limit {
                key static
                events {{ observability_snapshot_rate_limit_events | default(10) }}
                window {{ observability_snapshot_rate_limit_window | default('1m') }}
            }
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_console_backend_port | default('8080') }}
    }

    # ==========================================
    # Model Context Protocol (MCP) Server Ingress
    # ==========================================
{% if observability_mcp_enabled | default(true) | bool %}
{% if observability_mcp_grafana_enabled | default(true) | bool %}
    handle_path /mcp/grafana/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_grafana_port | default(8000) }}
    }
    handle_path /mcp/v1/grafana/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_grafana_port | default(8000) }}
    }
{% endif %}

{% if observability_mcp_victoriametrics_enabled | default(true) | bool %}
    handle_path /mcp/victoriametrics/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriametrics_port | default(8088) }}
    }
    handle_path /mcp/v1/metrics/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriametrics_port | default(8088) }}
    }
{% endif %}

{% if observability_mcp_victorialogs_enabled | default(true) | bool %}
    handle_path /mcp/victorialogs/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victorialogs_port | default(8081) }}
    }
    handle_path /mcp/v1/logs/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victorialogs_port | default(8081) }}
    }
{% endif %}

{% if observability_mcp_victoriatraces_enabled | default(true) | bool %}
    handle_path /mcp/victoriatraces/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriatraces_port | default(8082) }}
    }
    handle_path /mcp/v1/traces/* {
{% if observability_mcp_auth_enabled | default(true) | bool %}        basic_auth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriatraces_port | default(8082) }}
    }
{% endif %}
{% endif %}
}
