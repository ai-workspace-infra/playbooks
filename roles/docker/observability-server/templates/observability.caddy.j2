observability.svc.plus {
    # 自动走 Let's Encrypt / ZeroSSL 申请公共证书 (DNS已解析生效)

    # Root redirects to Grafana
    redir / /grafana/

    # Grafana (可视化大盘面板)
    handle /grafana/* {
        reverse_proxy 127.0.0.1:{{ observability_grafana_port | default('3030') }}
    }
    handle /grafana {
        redir * /grafana/
    }

    # ==========================================
    # VictoriaMetrics / Prometheus
    # ==========================================
    # [接收] 指标数据写入 (Remote Write) # VictoriaMetrics 写入入口
    handle_path /ingest/metrics/* {
        reverse_proxy 127.0.0.1:{{ observability_vmetrics_port | default('9090') }}
    }
    # [查询] 指标数据读取 (Query / UI)
    handle_path /vmetrics/* {
        reverse_proxy 127.0.0.1:{{ observability_prometheus_port | default('9090') }}
    }

    # ==========================================
    # VictoriaLogs / Loki
    # ==========================================
    # [接收] 日志数据写入 (Log Ingest)
    handle_path /ingest/logs/* {
        reverse_proxy 127.0.0.1:9428
    }
    # [查询] 日志数据读取 (Query / UI)
    handle_path /vlogs/* {
        reverse_proxy 127.0.0.1:9428
    }

    # ==========================================
    # OpenTelemetry / Jaeger
    # ==========================================
    # [接收] 链路数据写入 (OTLP Ingest)
    handle_path /ingest/otlp/* {
        reverse_proxy 127.0.0.1:4318
    }
    # [查询] 链路数据读取 (Trace Query / UI)
    handle_path /vtraces/* {
        reverse_proxy 127.0.0.1:10428
    }


{% if observability_vmalert_enabled | default(false) | bool %}
    # VictoriaMetrics Alerting Engine (告警引擎) —— 仅在回退到独立告警链路时启用
    handle_path /vmalert/* {
        reverse_proxy 127.0.0.1:8880
    }

    # Alertmanager (告警路由分发) —— 仅在回退到独立告警链路时启用
    handle_path /alertmgr/* {
        reverse_proxy 127.0.0.1:9059
    }
{% endif %}

    # Blackbox Exporter (网络与域名拨测)
    handle_path /blackbox/* {
        reverse_proxy 127.0.0.1:9115
    }

    # ==========================================
    # Telemetry Snapshots Export (流式压缩 & 带宽限制)
    # ==========================================
    handle /v1/telemetry/snapshots/export {
        encode gzip zstd
        rate_limit {
            zone snapshot_export_limit {
                key static
                events {{ observability_snapshot_rate_limit_events | default(10) }}
                window {{ observability_snapshot_rate_limit_window | default('1m') }}
            }
        }
        reverse_proxy 127.0.0.1:{{ observability_console_backend_port | default('8080') }}
    }

    # ==========================================
    # Model Context Protocol (MCP) Server Ingress
    # ==========================================
{% if observability_mcp_enabled | default(true) | bool %}
{% if observability_mcp_auth_enabled | default(false) | bool and observability_mcp_basic_auth_password_hash | default('') != '' %}
    handle /mcp/* {
        basicauth {
            {{ observability_mcp_basic_auth_user | default('mcp_agent') }} {{ observability_mcp_basic_auth_password_hash }}
        }
    }
{% endif %}

{% if observability_mcp_grafana_enabled | default(true) | bool %}
    handle_path /mcp/grafana/* {
        reverse_proxy 127.0.0.1:{{ observability_mcp_grafana_port | default(8000) }}
    }
{% endif %}

{% if observability_mcp_victoriametrics_enabled | default(true) | bool %}
    handle_path /mcp/victoriametrics/* {
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriametrics_port | default(8080) }}
    }
{% endif %}

{% if observability_mcp_victorialogs_enabled | default(false) | bool %}
    handle_path /mcp/victorialogs/* {
        reverse_proxy 127.0.0.1:{{ observability_mcp_victorialogs_port | default(8081) }}
    }
{% endif %}

{% if observability_mcp_victoriatraces_enabled | default(false) | bool %}
    handle_path /mcp/victoriatraces/* {
        reverse_proxy 127.0.0.1:{{ observability_mcp_victoriatraces_port | default(8082) }}
    }
{% endif %}
{% endif %}
}

