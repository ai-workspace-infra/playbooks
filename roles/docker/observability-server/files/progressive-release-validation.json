    {
      "id": 14,
      "title": "Flagger candidate weight",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "description": "Candidate traffic weight (%) for progressive rollouts. 0% indicates Primary 100%.",
      "targets": [
        {
