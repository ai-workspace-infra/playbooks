{
  "uid": "progressive-release-validation",
  "title": "Progressive Release Validation",
  "description": "Service \u00d7 API status matrix for progressive releases (PROD / SIT). Evaluates Blackbox endpoint health, response codes, latencies, freshness, and Flagger candidate traffic.",
  "tags": [
    "blackbox",
    "flagger",
    "release",
    "saas"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "P4169E866C3094E38"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "prod,sit",
        "current": {
          "selected": true,
          "text": "sit",
          "value": "sit"
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "textbox",
        "query": "SIT-K3S-V6",
        "current": {
          "selected": true,
          "text": "SIT-K3S-V6",
          "value": "SIT-K3S-V6"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "web-saas-sit",
        "current": {
          "selected": true,
          "text": "web-saas-sit",
          "value": "web-saas-sit"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: #111217; border: 1px solid #22252b; border-radius: 6px; padding: 14px 18px; height: 100%; display: flex; flex-direction: column; justify-content: center;\">\n  <div style=\"color: #9fa7b3; font-size: 13px; font-weight: 500; text-transform: capitalize;\">Environment</div>\n  <div style=\"color: #ffffff; font-size: 26px; font-weight: 700; letter-spacing: 0.5px; margin-top: 4px; text-transform: uppercase;\">$environment</div>\n</div>"
      }
    },
    {
      "id": 102,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: #111217; border: 1px solid #22252b; border-radius: 6px; padding: 14px 18px; height: 100%; display: flex; align-items: center; gap: 14px;\">\n  <div style=\"font-size: 24px; border: 1px solid #333842; border-radius: 6px; padding: 6px 8px; line-height: 1;\">\ud83d\udcc5</div>\n  <div>\n    <div style=\"color: #9fa7b3; font-size: 13px; font-weight: 500;\">Observation window</div>\n    <div style=\"color: #ffffff; font-size: 16px; font-weight: 600; margin-top: 3px;\">Last 15 minutes ($__from:date:HH:mm \u2013 $__to:date:HH:mm UTC)</div>\n  </div>\n</div>"
      }
    },
    {
      "id": 1,
      "title": "Probe gate \u00b7 all 10 checks",
      "type": "stat",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "description": "Release gate status across all 10 Blackbox endpoint checks. All must be 200/307 and healthy.",
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"}) and (count(probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"}) == 10)",
          "legendFormat": "Gate Status",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "BLOCKED (NO DATA)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PASSED  (10/10 checks healthy)",
                  "color": "green"
                },
                "0": {
                  "text": "BLOCKED  (endpoint checks failed)",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
