{
  "uid": "progressive-release-validation",
  "title": "Progressive Release Validation",
  "description": "Blackbox endpoint health and Flagger signals. Dashboard is observational and does not itself gate rollout. Requires progressive-release-probes with bounded service and route labels.",
  "tags": [
    "blackbox",
    "flagger",
    "release"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "prod,sit",
        "current": {
          "text": "prod",
          "value": "prod"
        }
      },
      {
        "name": "cluster",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "namespace",
        "type": "textbox",
        "query": "web-saas-prod",
        "current": {
          "text": "web-saas-prod",
          "value": "web-saas-prod"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Probe gate · all 10 checks",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "description": "Probe status only. Missing series yields NO DATA; this does not represent Flagger promotion.",
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"}) and (count(probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"}) == 10)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Failing endpoint checks",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "description": "NO DATA means the collector or all probes are absent.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Observed probes",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "description": "Expected 10 distinct targets per selected environment and cluster.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"progressive-release-probes\",environment=~\"$environment\",cluster=~\"$cluster\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
