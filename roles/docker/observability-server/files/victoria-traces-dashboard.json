      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "title": "Trace Spans Ingestion Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(victoriatraces_spans_created_total[5m])) or sum(rate(victoriatraces_rows_inserted_total[5m])) or vector(0)",
          "legendFormat": "Spans Inserted/s",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "title": "VictoriaTraces Storage & Ingestion Footprint",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "victoriatraces_data_size_bytes or victoriatraces_active_merges_total or vector(0)",
          "legendFormat": "Storage Bytes",
          "refId": "A"
        }
      ]
    }
  ]
