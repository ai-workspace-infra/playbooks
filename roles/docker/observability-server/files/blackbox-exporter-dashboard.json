        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Blackbox Exporter Probe & SSL Expiry Overview: HTTP/HTTPS target probe status, SSL certificate expiration countdown, and latency metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "blackbox-exporter-overview",
  "title": "Blackbox Exporter & SSL Probe Overview",
  "tags": ["blackbox", "probe", "ssl", "http", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "victoriametrics",
          "value": "victoriametrics"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "definition": "label_values(probe_success, target)",
        "hide": 0,
        "includeAll": true,
        "label": "Target Domain",
        "name": "target",
        "options": [],
        "query": {
          "query": "label_values(probe_success, target)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Probe Status & Health Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Global Probe Status",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "min(probe_success{target=~\"$target\"})",
          "legendFormat": "Status",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Targets Monitored",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "count(probe_success{target=~\"$target\"})",
          "legendFormat": "Targets",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["min"] } },
      "title": "Earliest SSL Expiry (Days)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "min((probe_ssl_earliest_cert_expiry{target=~\"$target\"} - time()) / 86400)",
          "legendFormat": "Days Left",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Avg Probe Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "avg(probe_duration_seconds{target=~\"$target\"})",
          "legendFormat": "Duration",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "probe_success" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
              ]},
              { "id": "displayName", "value": "探测状态" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "probe_http_status_code" },
            "properties": [
              { "id": "displayName", "value": "HTTP状态码" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "probe_duration_seconds" },
            "properties": [
              { "id": "displayName", "value": "响应耗时(ms)" },
              { "id": "unit", "value": "ms" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #D" },
            "properties": [
              { "id": "displayName", "value": "SSL剩余(天)" },
              { "id": "unit", "value": "d" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 15 }, { "color": "green", "value": 30 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [ { "id": "displayName", "value": "服务/目标名" } ]
          },
          {
            "matcher": { "id": "byName", "options": "target" },
            "properties": [ { "id": "displayName", "value": "探测 URL" } ]
          },
          {
            "matcher": { "id": "byName", "options": "env" },
            "properties": [ { "id": "displayName", "value": "环境" } ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "options": {
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [ { "displayName": "探测状态", "desc": false } ]
      },
      "title": "全域域名与 SSL 证书探测总览表",
      "type": "table",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "max by (name, target, env) (probe_success{target=~\"$target\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "probe_success"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "max by (name, target, env) (probe_http_status_code{target=~\"$target\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "probe_http_status_code"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "avg by (name, target, env) (probe_duration_seconds{target=~\"$target\"} * 1000)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "probe_duration_seconds"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "min by (name, target, env) ((probe_ssl_earliest_cert_expiry{target=~\"$target\"} - time()) / 86400)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 6,
      "title": "SSL Certificate Expiration & Probe Details",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "d"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "title": "SSL Certificate Expiry Countdown (Days)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "(probe_ssl_earliest_cert_expiry{target=~\"$target\"} - time()) / 86400",
          "legendFormat": "{{name}} ({{target}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "title": "Probe Latency Duration (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "probe_duration_seconds{target=~\"$target\"}",
          "legendFormat": "{{name}} ({{target}})",
          "refId": "A"
        }
      ]
    }
  ]
}
