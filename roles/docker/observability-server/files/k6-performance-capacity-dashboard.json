{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Grafana k6 Multi-Environment Load Testing & Capacity Stress Dashboard: Real-time throughput, resource utilization, availability, trace analysis, and slow query bottleneck identification.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "k6-performance-capacity-overview",
  "title": "k6 Performance & Capacity Stress Test Dashboard",
  "tags": ["k6", "performance", "capacity", "stress-test", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "UAT", "value": "uat" },
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "name": "environment",
        "options": [
          { "selected": false, "text": "SIT", "value": "sit" },
          { "selected": true, "text": "UAT", "value": "uat" },
          { "selected": false, "text": "PROD", "value": "prod" }
        ],
        "query": "sit,uat,prod",
        "type": "custom"
      },
      {
        "current": { "selected": true, "text": "victoriametrics", "value": "victoriametrics" },
        "hide": 0,
        "label": "Metrics DS",
        "name": "DS_METRICS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "victorialogs", "value": "victorialogs" },
        "hide": 0,
        "label": "Logs DS",
        "name": "DS_LOGS",
        "options": [],
        "query": "victoriametrics-logs-datasource",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "victoriatraces", "value": "victoriatraces" },
        "hide": 0,
        "label": "Traces DS",
        "name": "DS_TRACES",
        "options": [],
        "query": "jaeger",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
        "definition": "label_values(k6_http_reqs_total, testid)",
        "hide": 0,
        "includeAll": true,
        "label": "Test ID",
        "multi": true,
        "name": "testid",
        "options": [],
        "query": "label_values(k6_http_reqs_total, testid)",
        "refresh": 2,
        "type": "query",
        "allValue": ".*"
      },
      {
        "current": { "selected": true, "text": "All", "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
        "definition": "label_values(node_cpu_seconds_total, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Target Instance",
        "multi": true,
        "name": "target_instance",
        "options": [],
        "query": "label_values(node_cpu_seconds_total, instance)",
        "refresh": 2,
        "type": "query",
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "k6 Stress Test Executive Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["max"] } },
      "title": "Peak Throughput (RPS)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(k6_http_reqs_total{environment=~\"$environment\",testid=~\"$testid\"}[1m]))",
          "legendFormat": "Peak RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Availability / Success Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "(1 - (sum(rate(k6_http_reqs_total{status=~\"[45]..\",environment=~\"$environment\",testid=~\"$testid\"}[1m])) or vector(0)) / sum(rate(k6_http_reqs_total{environment=~\"$environment\",testid=~\"$testid\"}[1m]))) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "p95 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_http_req_duration_p95{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "p95 Duration",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["max"] } },
      "title": "Max Concurrent VUs (Capacity Ceiling)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_vus_max{testid=~\"$testid\"})",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "title": "Environment End-to-End Throughput (RPS), Concurrency & Latency Distribution",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "title": "Throughput (RPS) vs Active Virtual Users (VUs)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(k6_http_reqs_total{environment=~\"$environment\",testid=~\"$testid\"}[1m]))",
          "legendFormat": "HTTP RPS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(k6_vus{testid=~\"$testid\"})",
          "legendFormat": "Virtual Users (VUs)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "title": "Latency Quantiles (p50 / p90 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_http_req_duration_p50{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_http_req_duration_p90{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_http_req_duration_p95{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "p95",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_http_req_duration_p99{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "p99",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 9,
      "title": "Environment Resource Impact (Node CPU / Memory / IO)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 10,
      "title": "Target Node CPU Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$target_instance\"}[1m])) * 100)",
          "legendFormat": "CPU % - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 11,
      "title": "Target Node Memory Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$target_instance\"} / node_memory_MemTotal_bytes{instance=~\"$target_instance\"})) * 100",
          "legendFormat": "RAM % - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 14,
      "title": "Target Root Filesystem Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "100 * (1 - (node_filesystem_avail_bytes{instance=~\"$target_instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{instance=~\"$target_instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))",
          "legendFormat": "Disk % - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 15,
      "title": "Target Network Throughput",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{instance=~\"$target_instance\",device!~\"lo\"}[1m]) + rate(node_network_transmit_bytes_total{instance=~\"$target_instance\",device!~\"lo\"}[1m]))",
          "legendFormat": "Network - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 16,
      "title": "PostgreSQL Dependency Impact",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 33 },
      "id": 17,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "DB Connections During Test",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(pg_stat_database_numbackends{instance=~\"$target_instance\",datname!~\"template[01]\"})",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 33 },
      "id": 18,
      "title": "DB Transactions / Second",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(pg_stat_database_xact_commit{instance=~\"$target_instance\",datname!~\"template[01]\"}[1m])) + sum(rate(pg_stat_database_xact_rollback{instance=~\"$target_instance\",datname!~\"template[01]\"}[1m]))",
          "legendFormat": "Transactions",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 33 },
      "id": 19,
      "title": "DB Buffer Cache Hit Ratio",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{instance=~\"$target_instance\",datname!~\"template[01]\"}[1m])) / (sum(rate(pg_stat_database_blks_hit{instance=~\"$target_instance\",datname!~\"template[01]\"}[1m])) + sum(rate(pg_stat_database_blks_read{instance=~\"$target_instance\",datname!~\"template[01]\"}[1m])))",
          "legendFormat": "Cache hit %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 41 },
      "id": 20,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "PostgreSQL Exporter Up",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "min(pg_up{instance=~\"$target_instance\"})",
          "legendFormat": "pg_up",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 41 },
      "id": 21,
      "title": "PostgreSQL Lock Count",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum by (mode) (pg_locks_count{instance=~\"$target_instance\",datname!~\"template[01]\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 41 },
      "id": 22,
      "title": "Environment End-to-End API p95",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max by (endpoint) (k6_http_req_duration_p95{environment=~\"$environment\",testid=~\"$testid\"})",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "$DS_LOGS" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "id": 23,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": false
      },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "$DS_LOGS" },
          "expr": "{instance=~\"$target_instance\"}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Target Environment Logs (Trace ID / Test ID When Present)",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 },
      "id": 12,
      "title": "Bottleneck Analysis & Trace-to-Logs Correlation",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "$DS_TRACES" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 60 },
      "id": 13,
      "options": { "nodeGraph": { "enabled": true } },
      "description": "Displays server-side spans when Caddy/API services export OTLP to VictoriaTraces. k6 only propagates W3C trace context; it does not create server spans.",
      "title": "Slow Trace Spans Explorer (VictoriaTraces APM)",
      "type": "jaeger"
    }
  ]
}
