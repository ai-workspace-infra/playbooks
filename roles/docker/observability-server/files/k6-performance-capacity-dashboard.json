{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Grafana k6 Multi-Environment Load Testing & Capacity Stress Dashboard: Real-time throughput, resource utilization, availability, trace analysis, and slow query bottleneck identification.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "k6-performance-capacity-overview",
  "title": "k6 Performance & Capacity Stress Test Dashboard",
  "tags": ["k6", "performance", "capacity", "stress-test", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "victoriametrics", "value": "victoriametrics" },
        "hide": 0,
        "label": "Metrics DS",
        "name": "DS_METRICS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "victoriatraces", "value": "victoriatraces" },
        "hide": 0,
        "label": "Traces DS",
        "name": "DS_TRACES",
        "options": [],
        "query": "jaeger",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "victorialogs", "value": "victorialogs" },
        "hide": 0,
        "label": "Logs DS",
        "name": "DS_LOGS",
        "options": [],
        "query": "victoriametrics-logs-datasource",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "uat", "value": "uat" },
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "name": "environment",
        "options": [
          { "selected": false, "text": "sit", "value": "sit" },
          { "selected": true, "text": "uat", "value": "uat" },
          { "selected": false, "text": "prod", "value": "prod" }
        ],
        "query": "sit,uat,prod",
        "type": "custom"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "k6 Stress Test Executive Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["max"] } },
      "title": "Peak Throughput (RPS)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(k6_http_reqs{environment=~\"$environment\"}[1m])) or sum(rate(http_requests_total{env=~\"$environment\"}[1m])) or vector(0)",
          "legendFormat": "Peak RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Availability / Success Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "(1 - sum(rate(k6_http_reqs{status=~\"[45]..\", environment=~\"$environment\"}[1m])) / sum(rate(k6_http_reqs{environment=~\"$environment\"}[1m]))) * 100 or vector(100)",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "p95 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{environment=~\"$environment\"}[1m])) by (le)) or vector(0)",
          "legendFormat": "p95 Duration",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["max"] } },
      "title": "Max Concurrent VUs (Capacity Ceiling)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "max(k6_vus{environment=~\"$environment\"}) or vector(0)",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "title": "Throughput (RPS), Concurrency & Latency Distribution",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "title": "Throughput (RPS) vs Active Virtual Users (VUs)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(rate(k6_http_reqs{environment=~\"$environment\"}[1m]))",
          "legendFormat": "HTTP RPS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "sum(k6_vus{environment=~\"$environment\"})",
          "legendFormat": "Virtual Users (VUs)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "title": "Latency Quantiles (p50 / p90 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "histogram_quantile(0.50, sum(rate(k6_http_req_duration_bucket{environment=~\"$environment\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "histogram_quantile(0.90, sum(rate(k6_http_req_duration_bucket{environment=~\"$environment\"}[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{environment=~\"$environment\"}[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_bucket{environment=~\"$environment\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 9,
      "title": "Environment Resource Impact (Node CPU / Memory / IO)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 10,
      "title": "Target Node CPU Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU % - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 11,
      "title": "Target Node Memory Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$DS_METRICS" },
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM % - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 12,
      "title": "Bottleneck Analysis & Trace-to-Logs Correlation",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "$DS_TRACES" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "id": 13,
      "options": { "nodeGraph": { "enabled": true } },
      "title": "Slow Trace Spans Explorer (VictoriaTraces APM)",
      "type": "jaeger"
    }
  ]
}
