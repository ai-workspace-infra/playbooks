  "description": "XConnect Three-Tier Traffic Split (DIRECT -> Media-Pool Priority & Fallback -> Pro-EC2-Pool Whitelist & Blackhole) & 5+1 Pool Scheduling Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(xray_traffic_downlink_bytes_total{dimension=\"outbound\", target=\"pool-media-stream\", routing_pool=\"Media-Pool\", environment=~\"$environment\"}[5m])) / clamp_min(sum(rate(xray_traffic_downlink_bytes_total{dimension=\"outbound\", target=~\"pool-media-stream|blocked-media-on-pro\", environment=~\"$environment\"}[5m])), 1) * 100",
          "legendFormat": "Media-Pool Offload Ratio",
          "refId": "A"
        }
      ],
      "title": "Media-Pool (优先) 流媒体卸载比例 (%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(xray_traffic_downlink_bytes_total{dimension=\"outbound\", routing_pool=\"Pro-EC2-Pool\", target=\"pool-pro-ai-dev\", environment=~\"$environment\"}[5m])) / clamp_min(sum(rate(xray_traffic_downlink_bytes_total{dimension=\"outbound\", routing_pool=\"Pro-EC2-Pool\", environment=~\"$environment\"}[5m])), 1) * 100",
          "legendFormat": "Pro-EC2 Purity",
          "refId": "A"
        }
      ],
      "title": "Pro-EC2-Pool AI/开发白名单纯净度 (%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "decgbytes"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (routing_pool) (increase(xray_traffic_downlink_bytes_total{dimension=\"outbound\", environment=~\"$environment\"}[24h]) + increase(xray_traffic_uplink_bytes_total{dimension=\"outbound\", environment=~\"$environment\"}[24h])) / 1000000000",
          "legendFormat": "{{routing_pool}}",
          "refId": "A"
        }
      ],
      "title": "各路由池 24h 总流量 (GB)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000000 },
              { "color": "red", "value": 5000000 }
            ]
          },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
