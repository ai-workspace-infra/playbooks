      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(xray_traffic_uplink_bytes_total{dimension=\"outbound\", routing_pool=\"Pro-EC2-Pool\", target=\"blocked-media-on-pro\", environment=~\"$environment\"}[5m])) * 8",
          "legendFormat": "Blocked Media Attempts",
          "refId": "A"
        }
      ],
      "title": "Pro-EC2-Pool Blackhole 拦截流媒体尝试速率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (target) (rate(xray_traffic_downlink_bytes_total{dimension=\"outbound\", environment=~\"$environment\", routing_pool=~\"$routing_pool\", pricing_group=~\"$pricing_group\", instance=~\"$instance\"}[5m]) + rate(xray_traffic_uplink_bytes_total{dimension=\"outbound\", environment=~\"$environment\", routing_pool=~\"$routing_pool\", pricing_group=~\"$pricing_group\", instance=~\"$instance\"}[5m])) * 8",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "三层分流实时带宽分布 (按 target / outboundTag)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "100 - (avg by (instance, routing_pool) (rate(node_cpu_seconds_total{mode=\"idle\", environment=~\"$environment\", routing_pool=~\"$routing_pool\", instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "{{instance}} [{{routing_pool}}]",
          "refId": "A"
        }
      ],
      "title": "各路由池节点 CPU 利用率 (t4g.small 积分安全线 <=25%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
