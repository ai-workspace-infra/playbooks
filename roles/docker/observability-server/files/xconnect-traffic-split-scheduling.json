      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "namedprocess_namegroup_memory_bytes{memtype=\"resident\", environment=~\"$environment\", routing_pool=~\"$routing_pool\", instance=~\"$instance\", groupname=~\"fluxgate|haproxy|caddy|xray|xconnect-edge-agent\"}",
          "legendFormat": "{{instance}} - {{groupname}}",
          "refId": "A"
        }
      ],
      "title": "边缘代理引擎与 Xray 常驻内存 (RSS)",
      "type": "timeseries"
    }
  ],
