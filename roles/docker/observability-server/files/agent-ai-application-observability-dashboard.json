{
  "uid": "agent-ai-observability",
  "title": "Agent / AI Application Observability",
  "description": "Unified RED, GenAI usage, tool/MCP, logs and trace drill-down for OpenTelemetry-instrumented agents. Metrics are generated by the collector spanmetrics connector; token and cost panels use OTLP/OpenLIT metrics when emitted.",
  "tags": ["AGENT", "AI", "GENAI", "METRICS", "LOGS", "TRACES", "OTLP", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"title": "Explore metrics", "type": "link", "url": "/grafana/explore?left=%7B%22datasource%22%3A%22victoriametrics%22%7D", "icon": "external link", "includeTimeRange": true},
    {"title": "Explore logs", "type": "link", "url": "/grafana/explore?left=%7B%22datasource%22%3A%22victorialogs%22%7D", "icon": "external link", "includeTimeRange": true},
    {"title": "Explore traces", "type": "link", "url": "/grafana/explore?left=%7B%22datasource%22%3A%22victoriatraces%22%7D", "icon": "external link", "includeTimeRange": true}
  ],
  "templating": {"list": [
    {"name": "DS_METRICS", "label": "Metrics", "type": "datasource", "query": "prometheus", "current": {"text": "VictoriaMetrics", "value": "victoriametrics"}, "refresh": 1},
    {"name": "DS_LOGS", "label": "Logs", "type": "datasource", "query": "victoriametrics-logs-datasource", "current": {"text": "VictoriaLogs", "value": "victorialogs"}, "refresh": 1},
    {"name": "env", "label": "Environment", "type": "query", "datasource": {"uid": "$DS_METRICS"}, "definition": "label_values(traces_span_metrics_calls_total, env)", "query": "label_values(traces_span_metrics_calls_total, env)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}, "refresh": 2},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"uid": "$DS_METRICS"}, "definition": "label_values(traces_span_metrics_calls_total{env=~\"$env\"}, service_name)", "query": "label_values(traces_span_metrics_calls_total{env=~\"$env\"}, service_name)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}, "refresh": 2},
    {"name": "agent", "label": "Agent", "type": "query", "datasource": {"uid": "$DS_METRICS"}, "definition": "label_values(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\"}, agent_name)", "query": "label_values(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\"}, agent_name)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}, "refresh": 2}
  ]},
  "panels": [
    {"id": 1, "type": "row", "title": "Agent Overview", "collapsed": false, "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "panels": []},
    {"id": 2, "type": "stat", "title": "Active Agents", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "count(count by (agent_name) (increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[15m]) > 0))"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "colorMode": "background"}, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4}},
    {"id": 3, "type": "stat", "title": "Runs / Requests", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum(increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__range]))"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "colorMode": "value"}, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4}},
    {"id": 4, "type": "stat", "title": "Error Rate", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "100 * sum(rate(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\",status_code=~\"STATUS_CODE_ERROR|ERROR\"}[$__rate_interval])) / clamp_min(sum(rate(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])), 0.001)"}], "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4}},
    {"id": 5, "type": "stat", "title": "P50 Latency", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "ms"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4}},
    {"id": 6, "type": "stat", "title": "P95 Latency", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "ms"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}, "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4}},
    {"id": 7, "type": "stat", "title": "P99 Latency", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 5000}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}, "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4}},
    {"id": 8, "type": "timeseries", "title": "Runs / Requests and Errors", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum(rate(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval]))", "legendFormat": "Requests/s"}, {"refId": "B", "expr": "sum(rate(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\",status_code=~\"STATUS_CODE_ERROR|ERROR\"}[$__rate_interval]))", "legendFormat": "Errors/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 7}},
    {"id": 9, "type": "timeseries", "title": "Latency Percentiles", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))", "legendFormat": "P50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))", "legendFormat": "P95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval])))", "legendFormat": "P99"}], "fieldConfig": {"defaults": {"unit": "ms"}}, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 7}},
    {"id": 10, "type": "row", "title": "GenAI Usage & Cost", "collapsed": false, "gridPos": {"x": 0, "y": 12, "w": 24, "h": 1}, "panels": []},
    {"id": 11, "type": "timeseries", "title": "Token Input / Output / Cached", "description": "Requires OTLP GenAI usage metrics. OpenLIT metric names are matched alongside the current OpenTelemetry convention.", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum(increase({__name__=~\"gen_ai.*token.*|openlit.*token.*\",gen_ai_token_type=~\"input|prompt\",env=~\"$env\",service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "Input"}, {"refId": "B", "expr": "sum(increase({__name__=~\"gen_ai.*token.*|openlit.*token.*\",gen_ai_token_type=~\"output|completion\",env=~\"$env\",service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "Output"}, {"refId": "C", "expr": "sum(increase({__name__=~\"gen_ai.*token.*|openlit.*token.*\",gen_ai_token_type=~\"cache.*|cached\",env=~\"$env\",service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "Cached"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 0, "y": 13, "w": 12, "h": 7}},
    {"id": 12, "type": "bargauge", "title": "Cost by Agent / Model", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum by (agent_name, gen_ai_request_model) (increase({__name__=~\"gen_ai.*cost.*|openlit.*cost.*\",env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__range]))", "legendFormat": "{{agent_name}} / {{gen_ai_request_model}}"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}, "options": {"orientation": "horizontal", "displayMode": "gradient"}, "gridPos": {"x": 12, "y": 13, "w": 12, "h": 7}},
    {"id": 13, "type": "piechart", "title": "Model Usage", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum by (gen_ai_request_model) (increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\",gen_ai_request_model!=\"\"}[$__range]))", "legendFormat": "{{gen_ai_request_model}}"}], "options": {"legend": {"displayMode": "table", "placement": "right"}}, "gridPos": {"x": 0, "y": 20, "w": 8, "h": 7}},
    {"id": 14, "type": "bargauge", "title": "Tool Calls", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum by (tool_name) (increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\",tool_name!=\"\"}[$__range]))", "legendFormat": "{{tool_name}}"}], "options": {"orientation": "horizontal"}, "gridPos": {"x": 8, "y": 20, "w": 8, "h": 7}},
    {"id": 15, "type": "bargauge", "title": "MCP Calls", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum by (mcp_server_name) (increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\",mcp_server_name!=\"\"}[$__range]))", "legendFormat": "{{mcp_server_name}}"}], "options": {"orientation": "horizontal"}, "gridPos": {"x": 16, "y": 20, "w": 8, "h": 7}},
    {"id": 16, "type": "row", "title": "Distribution & Investigation", "collapsed": false, "gridPos": {"x": 0, "y": 27, "w": 24, "h": 1}, "panels": []},
    {"id": 17, "type": "piechart", "title": "Agent / Service Distribution", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "sum by (service_name, agent_name) (increase(traces_span_metrics_calls_total{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__range]))", "legendFormat": "{{service_name}} / {{agent_name}}"}], "options": {"legend": {"displayMode": "table", "placement": "right"}}, "gridPos": {"x": 0, "y": 28, "w": 8, "h": 8}},
    {"id": 18, "type": "table", "title": "Top Slow Traces / Operations", "description": "Use the Trace Explorer link above to open a selected operation's waterfall; metric exemplars link directly when the originating SDK provides trace IDs.", "datasource": {"uid": "$DS_METRICS"}, "targets": [{"refId": "A", "expr": "topk(20, histogram_quantile(0.95, sum by (le, service_name, span_name, agent_name) (rate(traces_span_metrics_duration_milliseconds_bucket{env=~\"$env\",service_name=~\"$service\",agent_name=~\"$agent\"}[$__rate_interval]))))", "format": "table"}], "fieldConfig": {"defaults": {"unit": "ms", "links": [{"title": "Open traces", "url": "/grafana/explore?left=%7B%22datasource%22%3A%22victoriatraces%22%7D", "targetBlank": false}] }}, "gridPos": {"x": 8, "y": 28, "w": 16, "h": 8}},
    {"id": 19, "type": "table", "title": "Recent Errors", "description": "Logs carrying trace_id expose a direct trace link through the VictoriaLogs derived field.", "datasource": {"type": "victoriametrics-logs-datasource", "uid": "$DS_LOGS"}, "targets": [{"refId": "A", "editorMode": "code", "expr": "i(error) env:~\"$env\" service_name:~\"$service\" | sort by (_time desc) | limit 100", "queryType": "instant"}], "fieldConfig": {"defaults": {"custom": {"filterable": true, "cellOptions": {"type": "auto", "wrapText": false}}}}, "gridPos": {"x": 0, "y": 36, "w": 24, "h": 9}}
  ]
}
