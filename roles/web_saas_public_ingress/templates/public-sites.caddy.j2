{
    admin off
    auto_https disable_redirects
}
# BEGIN managed shared PROD public SNI
{{ public_ingress.domains.console }}, console-selfhost-{{ web_saas_public_ingress_generation }}.svc.plus {
    tls {{ public_ingress.tls.directory }}/current/fullchain.pem {{ public_ingress.tls.directory }}/current/key.pem
    reverse_proxy console:3000
}
{{ public_ingress.domains.accounts }}, accounts-selfhost-{{ web_saas_public_ingress_generation }}.svc.plus {
    tls {{ public_ingress.tls.directory }}/current/fullchain.pem {{ public_ingress.tls.directory }}/current/key.pem
    reverse_proxy accounts:8080 {
        header_up X-Forwarded-Host svc.plus
    }
}
{{ public_ingress.domains.billing }}, billing-selfhost-{{ web_saas_public_ingress_generation }}.svc.plus {
    tls {{ public_ingress.tls.directory }}/current/fullchain.pem {{ public_ingress.tls.directory }}/current/key.pem
    @billing_ingest {
        method POST
        path /v1/ingest/snapshots
    }
    handle @billing_ingest {
        reverse_proxy billing:8081
    }
    @probe {
        method GET HEAD
        path /readyz /healthz /api/ping
    }
    handle @probe {
        reverse_proxy billing:8081
    }
    handle {
        respond 403
    }
}
{{ public_ingress.brand_domains.root }} {
    tls {{ public_ingress.brand_tls.directory }}/current/fullchain.pem {{ public_ingress.brand_tls.directory }}/current/key.pem
    reverse_proxy console:3000
}
{{ public_ingress.brand_domains.www }} {
    tls {{ public_ingress.brand_tls.directory }}/current/fullchain.pem {{ public_ingress.brand_tls.directory }}/current/key.pem
    redir https://{{ public_ingress.brand_domains.root }}{uri} 301
}
# END managed shared PROD public SNI
