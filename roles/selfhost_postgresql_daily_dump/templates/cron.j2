# Daily full PostgreSQL dump; keep the latest seven calendar dates in Shanghai time.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ={{ selfhost_pg_daily_dump_timezone }}
{{ selfhost_pg_daily_dump_schedule }} root {{ selfhost_pg_daily_dump_script_path }} >>/var/log/web-saas-pg-dumpall-backup.log 2>&1
