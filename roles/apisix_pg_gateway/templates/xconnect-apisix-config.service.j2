[Unit]
Description=XConnect APISIX PostgreSQL configuration API and synchronizer
After=xconnect-apisix.service
Requires=xconnect-apisix.service
ConditionPathExists={{ gateway_runtime_root }}/api.env

[Service]
Type=simple
User=root
WorkingDirectory={{ gateway_install_root }}
EnvironmentFile={{ gateway_environment_file }}
EnvironmentFile={{ gateway_runtime_root }}/api.env
EnvironmentFile={{ gateway_runtime_root }}/sync.env
Environment=APISIX_HOME={{ gateway_apisix_home }}
ExecStart={{ gateway_install_root }}/venv/bin/python {{ gateway_install_root }}/config-supervisor.py
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ gateway_config_root }} {{ gateway_runtime_root }} {{ gateway_state_root }}

[Install]
WantedBy=multi-user.target
