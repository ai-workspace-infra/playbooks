[Unit]
Description=XConnect APISIX PostgreSQL configuration API
After=network-online.target xconnect-apisix-uat-runtime.service
Wants=network-online.target
Requires=xconnect-apisix-uat-runtime.service
ConditionPathExists={{ gateway_runtime_root }}/api.env

[Service]
Type=simple
User=root
WorkingDirectory={{ gateway_install_root }}
EnvironmentFile={{ gateway_runtime_root }}/api.env
Environment=APISIX_HOME={{ gateway_apisix_home }}
ExecStart={{ gateway_install_root }}/venv/bin/python {{ gateway_install_root }}/gateway_config.py serve --gateway {{ gateway_id }} --bootstrap {{ gateway_config_root }}/config.yaml --validator {{ gateway_install_root }}/validate-native.sh --port {{ gateway_config_api_port }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ gateway_config_root }} {{ gateway_runtime_root }} {{ gateway_state_root }}

[Install]
WantedBy=multi-user.target
