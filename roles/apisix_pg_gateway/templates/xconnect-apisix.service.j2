[Unit]
Description=XConnect regional APISIX Standalone edge gateway
After=network-online.target {{ gateway_runtime_mount_unit }}
Wants=network-online.target
Requires={{ gateway_runtime_mount_unit }}
ConditionPathExists={{ gateway_config_root }}/config.yaml
ConditionPathExists={{ gateway_config_root }}/apisix.yaml

[Service]
Type=forking
User=root
WorkingDirectory={{ gateway_apisix_home }}
EnvironmentFile={{ gateway_environment_file }}
EnvironmentFile={{ gateway_secret_env_file }}
Environment=APISIX_HOME={{ gateway_apisix_home }}
PIDFile={{ gateway_apisix_home }}/logs/nginx.pid
ExecStartPre={{ gateway_install_root }}/venv/bin/python {{ gateway_install_root }}/prepare_runtime.py
ExecStartPre={{ gateway_apisix_binary }} test -c {{ gateway_config_root }}/config.yaml
ExecStart={{ gateway_apisix_binary }} start -c {{ gateway_config_root }}/config.yaml
ExecStop={{ gateway_apisix_binary }} stop -c {{ gateway_config_root }}/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ gateway_apisix_home }} {{ gateway_config_root }} {{ gateway_runtime_root }}

[Install]
WantedBy=multi-user.target
