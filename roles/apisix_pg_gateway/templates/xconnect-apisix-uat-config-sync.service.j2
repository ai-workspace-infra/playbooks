[Unit]
Description=XConnect APISIX PostgreSQL JSONB synchronizer
After=xconnect-apisix-uat.service xconnect-apisix-uat-config-api.service
Wants=xconnect-apisix-uat.service
Requires=xconnect-apisix-uat-config-api.service
ConditionPathExists={{ gateway_runtime_root }}/sync.env

[Service]
Type=simple
User=root
WorkingDirectory={{ gateway_install_root }}
EnvironmentFile={{ gateway_runtime_root }}/sync.env
Environment=APISIX_HOME={{ gateway_apisix_home }}
Environment=GATEWAY_PROBE_URL={{ gateway_probe_url }}
ExecStart={{ gateway_install_root }}/venv/bin/python {{ gateway_install_root }}/gateway_config.py sync --gateway {{ gateway_id }} --bootstrap {{ gateway_config_root }}/config.yaml --api http://127.0.0.1:{{ gateway_config_api_port }} --validator {{ gateway_install_root }}/validate-native.sh --output {{ gateway_config_root }}/apisix.yaml --state {{ gateway_state_root }}/state.json --probe "{{ gateway_install_root }}/venv/bin/python {{ gateway_install_root }}/probe-local.py"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ gateway_config_root }} {{ gateway_runtime_root }} {{ gateway_state_root }}

[Install]
WantedBy=multi-user.target
