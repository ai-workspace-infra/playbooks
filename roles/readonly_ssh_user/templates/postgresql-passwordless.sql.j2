BEGIN;
SET LOCAL lock_timeout='10s';
SET LOCAL statement_timeout='30s';
SELECT pg_advisory_xact_lock(721043110);
SELECT set_config('migration_access.before', md5(
 COALESCE((SELECT ROW(rolname,rolcanlogin,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls,rolinherit,rolconfig)::text FROM pg_roles WHERE rolname='readonly_release'),'absent') ||
 COALESCE((SELECT string_agg(oid::text||COALESCE(relacl::text,''),',' ORDER BY oid) FROM pg_class WHERE relnamespace='public'::regnamespace),'') ||
 COALESCE((SELECT datacl::text FROM pg_database WHERE datname=current_database()),'') ||
 COALESCE((SELECT nspacl::text FROM pg_namespace WHERE nspname='public'),'')), true);
DO $reader$
BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='readonly_release') THEN
  CREATE ROLE readonly_release LOGIN PASSWORD NULL NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_authid WHERE rolname='readonly_release' AND rolcanlogin AND rolpassword IS NULL
    AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit)
    OR EXISTS (SELECT 1 FROM pg_auth_members WHERE member=(SELECT oid FROM pg_roles WHERE rolname='readonly_release'))
    OR EXISTS (SELECT 1 FROM pg_class WHERE relowner=(SELECT oid FROM pg_roles WHERE rolname='readonly_release')) THEN
  RAISE EXCEPTION 'Existing migration identity has incompatible credentials, membership or ownership; manual review required';
 END IF;
 IF EXISTS (SELECT 1 FROM pg_proc p WHERE p.pronamespace='public'::regnamespace AND p.prosecdef
    AND has_function_privilege('readonly_release',p.oid,'EXECUTE')) THEN
  RAISE EXCEPTION 'Executable security-definer routines require explicit review';
 END IF;
END $reader$;
ALTER ROLE readonly_release SET default_transaction_read_only=on;
GRANT CONNECT ON DATABASE {{ readonly_database_name }} TO readonly_release;
GRANT USAGE ON SCHEMA public TO readonly_release;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM readonly_release;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO readonly_release;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM readonly_release;
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO readonly_release;
DO $policies$
DECLARE tab record;
BEGIN
 FOR tab IN SELECT c.oid,c.relname FROM pg_class c WHERE c.relnamespace='public'::regnamespace
 AND c.relkind IN ('r','p') AND c.relrowsecurity LOOP
  IF EXISTS (SELECT 1 FROM pg_policy p WHERE p.polrelid=tab.oid AND NOT p.polpermissive
    AND p.polcmd IN ('r','*') AND (0::oid=ANY(p.polroles) OR (SELECT oid FROM pg_roles WHERE rolname='readonly_release')=ANY(p.polroles))) THEN
   RAISE EXCEPTION 'Restrictive source policy requires explicit review';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_policy WHERE polrelid=tab.oid AND polname='release_initialization_readonly') THEN
   IF NOT EXISTS (SELECT 1 FROM pg_policy p WHERE p.polrelid=tab.oid AND p.polname='release_initialization_readonly'
     AND p.polcmd='r' AND p.polpermissive AND p.polroles=ARRAY[(SELECT oid FROM pg_roles WHERE rolname='readonly_release')]
     AND pg_get_expr(p.polqual,p.polrelid)='true' AND p.polwithcheck IS NULL) THEN
    RAISE EXCEPTION 'Existing source reader policy differs; manual review required';
   END IF;
  ELSE
   EXECUTE format('CREATE POLICY release_initialization_readonly ON public.%I FOR SELECT TO readonly_release USING(true)',tab.relname);
  END IF;
 END LOOP;
END $policies$;
DO $verify$
BEGIN
 IF has_schema_privilege('readonly_release','public','CREATE') OR EXISTS (
 SELECT 1 FROM pg_class c WHERE c.relnamespace='public'::regnamespace AND c.relkind IN ('r','p') AND
 (has_table_privilege('readonly_release',c.oid,'INSERT') OR has_table_privilege('readonly_release',c.oid,'UPDATE') OR
  has_table_privilege('readonly_release',c.oid,'DELETE') OR has_table_privilege('readonly_release',c.oid,'TRUNCATE')))
 OR EXISTS (SELECT 1 FROM pg_class c WHERE c.relnamespace='public'::regnamespace
 AND CASE WHEN c.relkind='S' THEN has_sequence_privilege('readonly_release',c.oid,'USAGE,UPDATE') ELSE false END) THEN
  RAISE EXCEPTION 'Effective public privileges would permit permanent writes';
 END IF;
END $verify$;
SELECT CASE WHEN current_setting('migration_access.before') = md5(
 COALESCE((SELECT ROW(rolname,rolcanlogin,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls,rolinherit,rolconfig)::text FROM pg_roles WHERE rolname='readonly_release'),'absent') ||
 COALESCE((SELECT string_agg(oid::text||COALESCE(relacl::text,''),',' ORDER BY oid) FROM pg_class WHERE relnamespace='public'::regnamespace),'') ||
 COALESCE((SELECT datacl::text FROM pg_database WHERE datname=current_database()),'') ||
 COALESCE((SELECT nspacl::text FROM pg_namespace WHERE nspname='public'),'')) THEN 'unchanged' ELSE 'changed' END;
COMMIT;
