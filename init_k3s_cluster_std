- name: set artifact cluster with vhosts
  hosts: all
  user: root
  become: yes
  gather_facts: yes
  tasks:
    - include_role:
        name: vhosts/k3s-cluster-server
      when: inventory_hostname in groups['master']
      vars:
        k3s_platform_k3s_version: 'v1.27.2+k3s1'
        k3s_platform_cluster_cidr: '10.10.0.0/16'
        k3s_platform_service_cidr: '172.16.0.0/16'
    - include_role:
        name: k3s-addon
      vars:
        group: master
        ingress: nginx
        external_dns: enable
        cert_issuance: vault
