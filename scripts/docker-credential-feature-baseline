#!/usr/bin/env python3
"""Docker credential helper: forward a masked, in-memory GHCR pull identity."""
import json
import os
import sys

if len(sys.argv) != 2 or sys.argv[1] != 'get':
    sys.exit(1)
server = sys.stdin.readline().strip()
if server not in ('ghcr.io', 'https://ghcr.io'):
    sys.exit(1)
username = os.environ.get('FEATURE_GHCR_USERNAME', '')
secret = os.environ.get('FEATURE_GHCR_TOKEN', '')
if not username or not secret or '\n' in username or '\n' in secret:
    sys.exit(1)
json.dump({'Username': username, 'Secret': secret}, sys.stdout)
