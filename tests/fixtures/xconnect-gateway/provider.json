{
  "schema_version": 1,
  "id": "xconnect-one",
  "version": "0.1.0",
  "mode": "shadow",
  "snapshot_schema": {"minimum": 1, "maximum": 1},
  "runtime": {"proxy_core": "xray", "proxy_core_version": "26.3.27"},
  "capabilities": [
    "peer.validate",
    "peer.render",
    "peer.read-back",
    "policy.validate",
    "policy.render",
    "relay.validate",
    "relay.render",
    "diagnostics.collect"
  ],
  "backends": {"peer": "wireguard", "policy": "nftables", "relay": "xray"},
  "permissions": {"apply_runtime": false, "linux_capabilities": []},
  "rollback": {
    "level": "last-known-good",
    "directory": "/var/lib/xconnect/gateway/last-known-good"
  }
}
