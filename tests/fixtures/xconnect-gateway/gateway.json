{
  "schema_version": 1,
  "node_id": "fixture-gateway",
  "mode": "shadow",
  "control_plane": {
    "url": "https://accounts.svc.plus",
    "poll_interval_seconds": 30,
    "credentials_file": "/etc/xconnect/gateway/node-credential.token",
    "snapshot_signing_public_key_file": "/etc/xconnect/gateway/snapshot-signing.pub",
    "snapshot_signing_key_id": "signing_key_01",
    "api_version": "v1"
  },
  "identity": {
    "node_id": "fixture-gateway",
    "credential_type": "short-lived-bearer-file",
    "credential_file": "/etc/xconnect/gateway/node-credential.token"
  },
  "provider_manifest": "/etc/xconnect/gateway/providers.d/xconnect-one.json",
  "authority": {
    "projection_source": "static-shadow",
    "readiness_evidence_file": "/var/lib/xconnect/gateway/evidence/accounts-only-readiness.json"
  },
  "runtime": {
    "proxy_core": "xray",
    "proxy_core_version": "26.3.27",
    "xray_binary": "/usr/local/bin/xray",
    "xray_config": "/usr/local/etc/xray/wireguard-over-vless.json",
    "xray_service": "xray-wg-tproxy",
    "wireguard_interface": "wg-xwm",
    "wireguard_config": "/etc/wireguard/wg-xwm.conf",
    "wireguard_service": "wg-quick@wg-xwm"
  },
  "snapshots": {
    "candidate_dir": "/var/lib/xconnect/gateway/candidates",
    "last_known_good_dir": "/var/lib/xconnect/gateway/last-known-good",
    "evidence_dir": "/var/lib/xconnect/gateway/evidence",
    "minimum_schema": 1,
    "maximum_schema": 1,
    "empty_peer_snapshot": "require-explicit-override"
  },
  "apply": {"enabled": false},
  "health": {
    "listen_host": "127.0.0.1",
    "listen_port": 9789,
    "path": "/healthz"
  },
  "logging": {
    "format": "json",
    "redact_fields": ["authorization", "credential", "token", "signature.value"]
  }
}
